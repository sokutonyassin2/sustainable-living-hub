---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase.js';

// Fetch Content Blocks for Home
const { data: blocksData } = await supabase.from('content_blocks').select('*').eq('page', 'home');
const blocks = {};
if (blocksData) {
  blocksData.forEach(b => {
    blocks[b.block_key] = b.value;
  });
}

// Fetch Latest 3 Blogs
let latestBlogs = [];
try {
  const { data } = await supabase.from('blogs')
    .select('*')
    .eq('is_published', true)
    .order('created_at', { ascending: false })
    .limit(3);
  if (data && Array.isArray(data) && data.length > 0) {
    latestBlogs = data;
  }
} catch (e) {
  console.warn("Supabase blogs fetch skipped/fallback:", e);
}

// Built-in Demo Blog Posts (ensures home page always showcases rich, verified articles)
const demoBlogs = [
  {
    title: 'From "Hell" to a Living Laboratory: The Story of My Land in Senga',
    slug: 'post-1-healthy-soil',
    created_at: '2026-05-15T09:00:00.000Z',
    image_url: '/blog_soil.png',
    content: 'A personal journey of doubt, loss, persistence, and restoring life to an exhausted piece of land through living soil science and ecological farming.'
  },
  {
    title: 'How to Become a Tree Billionaire in 5 Years',
    slug: 'post-2-tree-billionaire',
    created_at: '2026-06-02T10:00:00.000Z',
    image_url: '/blog_tree.png',
    content: 'Planting trees is not just an act of love for the environment — it is a generational investment. Learn how BOS turns ordinary farmers into Tree Billionaires.'
  },
  {
    title: 'Urban Rooftop Farming: Feeding Cities from Above',
    slug: 'post-3-urban-rooftop',
    created_at: '2026-06-20T11:00:00.000Z',
    image_url: '/blog_rooftop.png',
    content: 'Cities need not be food deserts. Discover how BOS Smart Villages are transforming rooftops into productive organic gardens that feed families.'
  }
];

// Combine custom Supabase blogs with demo blogs so the grid is always complete
const displayBlogs = [...latestBlogs];
for (const demo of demoBlogs) {
  if (displayBlogs.length >= 3) break;
  if (!displayBlogs.some(b => b.slug === demo.slug)) {
    displayBlogs.push(demo);
  }
}

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
