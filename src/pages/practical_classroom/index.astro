---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Classroom">
    
<!-- Hero Section -->
<section class="mb-stack-lg relative overflow-hidden rounded-xl bg-surface-container-low border border-surface-variant p-8 md:p-16 flex flex-col md:flex-row items-center gap-12 shadow-[0_4px_24px_rgba(78,54,41,0.05)]">
<div class="md:w-1/2 z-10">
<h1 class="font-display text-display text-primary mb-stack-sm">Champion Farmer in Action</h1>
<div class="font-body-lg text-body-lg text-on-surface-variant mb-stack-md space-y-4">
<p>Welcome to my practical classroom this farm. This is where ideas meet reality.</p>
<p>Come on, let’s move together as I test what works, what fails, and what can be improved. It is practical.</p>
<p>Do it at your end, with a few tweaks here and there. Give me feedback.</p>
<p>I will be delighted to learn from you what works, what doesn’t, and where we can improve together.</p>
<p>The best knowledge is the one we build together.</p>
</div>
<div class="flex items-center gap-4">
<div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">psychology</span>
</div>
<div>
<p class="font-label-md text-label-md text-on-background">Your Progress</p>
<p class="font-caption text-caption text-outline">Test what works, what fails, and what can be improved</p>
</div>
</div>
</div>
<div class="md:w-1/2 relative h-64 md:h-96 w-full rounded-lg overflow-hidden shadow-[0_8px_32px_rgba(78,54,41,0.08)]">
<img alt="Hands working in rich soil" class="w-full h-full object-cover" data-alt="A close-up photograph of weathered hands gently turning rich, dark organic soil. Small green sprouts are visible. Warm, golden-hour sunlight grazes the scene, creating deep, soft shadows. The overall aesthetic feels grounded, earthy, and hopeful, utilizing a palette of deep soil browns and vibrant organic greens to reflect agricultural science." src="https://lh3.googleusercontent.com/aida-public/AB6AXuC3uzSpyhMjcBU3c0rZ4XC93pXGnwQQ3HDkiUH1fLy4raGuylUkh9Vm4g3Qs1iDiNf6iYlTFC2L6aTosiWOHdHoe5SZrEaeRVKXoPd1tXx2lyFvhM-vweD9UkWsCdpO91VLVMsQlA_w3NKpn1ihd65qW3uplQt7MsP1uany1mV8hM8PK3MjMad7BBEOVSPVKmZs40o8mubO110m1PuH7BHw9dIAhtP7Vx1cvIA_7-rJR2nAv4GQWP7esYWq5Jcjrpo3otFFavPQ9fRx"/>
</div>
</section>
<!-- Lesson Hub Grid -->
<section class="mb-stack-lg">
<div class="flex justify-between items-end mb-stack-md">
<h2 class="font-h2 text-h2 text-primary">Lesson Hub</h2>
<a class="font-label-md text-label-md text-secondary hover:text-on-secondary-fixed transition-colors flex items-center gap-2" href="#">
                    View Path <span class="material-symbols-outlined">arrow_forward</span>
</a>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
<!-- Module 1 -->
<div class="bg-surface rounded-lg border border-outline-variant p-6 shadow-[0_4px_16px_rgba(78,54,41,0.05)] hover:shadow-[0_8px_24px_rgba(78,54,41,0.08)] transition-all flex flex-col h-full">
<div class="flex justify-between items-start mb-4">
<div class="w-10 h-10 rounded-DEFAULT bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">eco</span>
</div>
<span class="bg-primary-fixed text-on-primary-fixed font-caption text-caption px-3 py-1 rounded-full">In Progress</span>
</div>
<h3 class="font-h3 text-h3 text-on-background mb-2">Feed the Soil</h3>
<p class="font-caption text-caption text-on-surface-variant mb-6 flex-grow">Healthy soil is the foundation of everything we grow. When you feed the soil, you are feeding life itself.</p>
<div class="mt-auto">
<div class="flex justify-between font-caption text-caption text-outline mb-2">
<span>60% Complete</span>
<span>3 Lessons</span>
</div>
<div class="w-full bg-surface-variant h-2 rounded-full overflow-hidden">
<div class="bg-primary h-full rounded-full" style="width: 60%;"></div>
</div>
<button class="w-full mt-6 bg-surface-container-high text-primary font-label-md text-label-md py-2 rounded-DEFAULT hover:bg-surface-dim transition-colors border border-outline-variant">
                            Continue Lesson
                        </button>
</div>
</div>
<!-- Module 2 -->
<div class="bg-surface rounded-lg border border-outline-variant p-6 shadow-[0_4px_16px_rgba(78,54,41,0.05)] hover:shadow-[0_8px_24px_rgba(78,54,41,0.08)] transition-all flex flex-col h-full">
<div class="flex justify-between items-start mb-4">
<div class="w-10 h-10 rounded-DEFAULT bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">recycling</span>
</div>
<span class="bg-surface-variant text-on-surface-variant font-caption text-caption px-3 py-1 rounded-full">Not Started</span>
</div>
<h3 class="font-h3 text-h3 text-on-background mb-2">Waste Nothing. Grow Everything.</h3>
<p class="font-caption text-caption text-on-surface-variant mb-6 flex-grow">In nature, nothing is wasted. What may be considered waste elsewhere becomes a valuable resource here.</p>
<div class="mt-auto">
<div class="flex justify-between font-caption text-caption text-outline mb-2">
<span>0% Complete</span>
<span>4 Lessons</span>
</div>
<div class="w-full bg-surface-variant h-2 rounded-full overflow-hidden">
<div class="bg-primary h-full rounded-full" style="width: 0%;"></div>
</div>
<button class="w-full mt-6 bg-primary text-on-primary font-label-md text-label-md py-2 rounded-DEFAULT hover:bg-primary-container transition-colors">
                            Start Module
                        </button>
</div>
</div>
<!-- Module 3 -->
<div class="bg-surface rounded-lg border border-outline-variant p-6 shadow-[0_4px_16px_rgba(78,54,41,0.05)] hover:shadow-[0_8px_24px_rgba(78,54,41,0.08)] transition-all flex flex-col h-full">
<div class="flex justify-between items-start mb-4">
<div class="w-10 h-10 rounded-DEFAULT bg-inverse-primary flex items-center justify-center text-on-primary-fixed-variant">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">water_drop</span>
</div>
<span class="bg-surface-variant text-on-surface-variant font-caption text-caption px-3 py-1 rounded-full">Locked</span>
</div>
<h3 class="font-h3 text-h3 text-on-background mb-2">Climate-Smart Farming</h3>
<p class="font-caption text-caption text-on-surface-variant mb-6 flex-grow">Rains are uncertain and seasons are shifting. Trenches, mulching, and trees help build resilience step by step.</p>
<div class="mt-auto">
<div class="flex justify-between font-caption text-caption text-outline mb-2">
<span>Prerequisite required</span>
<span>5 Lessons</span>
</div>
<div class="w-full bg-surface-variant h-2 rounded-full overflow-hidden">
<div class="bg-outline-variant h-full rounded-full" style="width: 100%;"></div>
</div>
<button class="w-full mt-6 bg-transparent text-outline font-label-md text-label-md py-2 rounded-DEFAULT cursor-not-allowed border border-surface-variant flex items-center justify-center gap-2">
<span class="material-symbols-outlined text-[18px]">lock</span> Locked
                        </button>
</div>
</div>
</div>
</section>
<!-- Interactive Soil Health & Carbon Capture Estimator -->
<section class="mb-stack-lg bg-surface-container-low rounded-2xl border border-surface-variant p-8 shadow-[0_8px_32px_rgba(78,54,41,0.06)] overflow-hidden relative">
    <!-- Background element -->
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-primary/5 to-transparent pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-64 h-64 bg-primary rounded-full opacity-10 blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col mb-8">
        <div class="inline-flex items-center gap-2 mb-3">
            <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">compost</span>
            <span class="font-label-md text-label-md text-primary tracking-wide uppercase">Interactive Tool</span>
        </div>
        <h2 class="font-h2 text-h2 text-primary-container">Feed the Soil. The Soil Feeds You.</h2>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl mt-2">
            There is an old adage: you cannot milk a cow without feeding it. In farming, we often focus on the harvest we expect, and forget what the soil needs to give it.
        </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 relative z-10">
        <!-- Inputs Column -->
        <div class="lg:col-span-5 flex flex-col gap-6">
            <div class="bg-surface rounded-xl p-6 border border-outline-variant/40 shadow-sm">
                <label for="soil-type" class="block font-label-md text-label-md text-secondary mb-2">Current Soil Type</label>
                <select id="soil-type" class="w-full bg-surface-container border border-outline-variant rounded-lg px-4 py-3 font-body-md text-on-background focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all cursor-pointer">
                    <option value="clay">Compacted Clay (Low Porosity)</option>
                    <option value="sand">Sandy Dryland (Low Retention)</option>
                    <option value="depleted">Depleted Loam (Low Organic Matter)</option>
                </select>

                <div class="mt-6">
                    <div class="flex justify-between items-end mb-2">
                        <label for="land-size" class="block font-label-md text-label-md text-secondary">Land Area (Acres)</label>
                        <span id="land-size-display" class="font-display text-h3 text-primary">1.5</span>
                    </div>
                    <input type="range" id="land-size" min="0.1" max="10" step="0.1" value="1.5" class="w-full h-2 bg-surface-variant rounded-lg appearance-none cursor-pointer accent-primary">
                    <div class="flex justify-between text-xs text-outline mt-2 font-caption">
                        <span>0.1 Acres</span>
                        <span>10 Acres</span>
                    </div>
                </div>
            </div>

            <div class="bg-tertiary-container text-on-tertiary-container rounded-xl p-6">
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-tertiary-fixed shrink-0">info</span>
                    <p class="font-caption text-caption">Estimates are based on dryland restoration techniques documented at our Kyampisi site over a 3-year transformation period.</p>
                </div>
            </div>
        </div>

        <!-- Results Column -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Result Card 1 -->
            <div class="bg-surface rounded-xl p-6 border border-outline-variant/40 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">compost</span>
                    </div>
                    <span class="font-label-md text-label-md text-on-surface">Vermicompost</span>
                </div>
                <div>
                    <div class="flex items-baseline gap-2">
                        <span id="res-compost" class="font-display text-display text-secondary transition-all duration-300">4.5</span>
                        <span class="font-body-md text-on-surface-variant">Tons</span>
                    </div>
                    <p class="font-caption text-caption text-outline mt-1">Recommended initial application.</p>
                </div>
            </div>

            <!-- Result Card 2 -->
            <div class="bg-surface rounded-xl p-6 border border-outline-variant/40 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-full bg-tertiary-container text-on-tertiary-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">grass</span>
                    </div>
                    <span class="font-label-md text-label-md text-on-surface">Cover Crop Seed</span>
                </div>
                <div>
                    <div class="flex items-baseline gap-2">
                        <span id="res-seed" class="font-display text-display text-tertiary transition-all duration-300">12</span>
                        <span class="font-body-md text-on-surface-variant">kg</span>
                    </div>
                    <p class="font-caption text-caption text-outline mt-1" id="res-seed-type">Deep-rooting mix (Mucuna/Lablab).</p>
                </div>
            </div>

            <!-- Result Card 3 (Full Width) -->
            <div class="bg-primary-container text-on-primary-container rounded-xl p-6 shadow-sm flex flex-col justify-between sm:col-span-2 relative overflow-hidden">
                <div class="absolute right-0 bottom-0 opacity-10 pointer-events-none transform translate-x-4 translate-y-4">
                    <span class="material-symbols-outlined text-[120px]" style="font-variation-settings: 'FILL' 1;">co2</span>
                </div>
                <div class="relative z-10 flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">air</span>
                    </div>
                    <span class="font-label-md text-label-md">Est. Carbon Capture</span>
                </div>
                <div class="relative z-10">
                    <div class="flex items-baseline gap-2">
                        <span id="res-carbon" class="font-display text-[64px] leading-none text-primary font-bold transition-all duration-300">3,450</span>
                        <span class="font-body-lg text-primary-fixed-dim">kg CO₂ / year</span>
                    </div>
                    <p class="font-caption text-caption text-primary-fixed-dim mt-2 max-w-md">Estimated annual sequestration potential once the soil microbial life and deep-root systems are established.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Split Layout: Spotlight & Feedback -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter mb-stack-lg">
<!-- Interactive Tip Spotlight -->
<section class="lg:col-span-5 bg-tertiary-container text-on-tertiary-container rounded-xl p-8 relative overflow-hidden shadow-[0_8px_24px_rgba(78,54,41,0.08)]">
<div class="absolute -right-12 -top-12 w-64 h-64 bg-tertiary rounded-full opacity-20 blur-3xl"></div>
<div class="relative z-10 h-full flex flex-col justify-between">
<div>
<div class="flex items-center gap-2 mb-6">
<span class="material-symbols-outlined text-tertiary-fixed" style="font-variation-settings: 'FILL' 1;">lightbulb</span>
<span class="font-label-md text-label-md text-tertiary-fixed tracking-wide uppercase">Spotlight</span>
</div>
<h3 class="font-h2 text-h2 text-on-tertiary mb-4">The Best Knowledge Is Built Together</h3>
<p class="font-body-md text-body-md text-tertiary-fixed-dim mb-8">
                            Do it at your end, with a few tweaks here and there. Give me feedback. I will be delighted to learn from you - what works, what does not, and where we can improve together.
                        </p>
</div>
<a class="inline-flex items-center gap-2 text-on-tertiary font-label-md text-label-md hover:text-tertiary-fixed transition-colors border-b border-transparent hover:border-tertiary-fixed pb-1 w-max" href="#">
                        Explore WaSA Techniques <span class="material-symbols-outlined">arrow_forward</span>
</a>
</div>
</section>
<!-- Feedback Loop -->
<section class="lg:col-span-7 bg-surface-container-lowest border border-surface-container-highest rounded-xl p-8 shadow-[0_4px_16px_rgba(78,54,41,0.03)] flex flex-col">
<div class="mb-6">
<h3 class="font-h2 text-h2 text-primary mb-2">Share Your Progress</h3>
<p class="font-body-md text-body-md text-on-surface-variant">Community learning thrives on real-world application. What worked on your farm this week?</p>
</div>
<form class="flex flex-col flex-grow">
<div class="relative flex-grow mb-4">
<textarea class="w-full h-full min-h-[120px] bg-surface-container-low border border-outline-variant rounded-lg p-4 font-body-md text-body-md text-on-background focus:border-secondary focus:ring-1 focus:ring-secondary resize-none placeholder-outline" placeholder="Describe your field experiment or observation..."></textarea>
</div>
<div class="flex flex-wrap items-center justify-between gap-4 mt-auto pt-4 border-t border-surface-variant">
<div class="flex gap-2">
<button class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant hover:bg-surface-container-high transition-colors" type="button">
<span class="material-symbols-outlined text-[20px]">add_photo_alternate</span>
</button>
<button class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant hover:bg-surface-container-high transition-colors" type="button">
<span class="material-symbols-outlined text-[20px]">location_on</span>
</button>
</div>
<button class="bg-secondary text-on-secondary font-label-md text-label-md px-6 py-2 rounded-DEFAULT hover:bg-on-secondary-container transition-colors flex items-center gap-2" type="submit">
                            Publish <span class="material-symbols-outlined text-[18px]">send</span>
</button>
</div>
</form>
</section>
</div>

    
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const soilType = document.getElementById('soil-type');
        const landSize = document.getElementById('land-size');
        const landSizeDisplay = document.getElementById('land-size-display');
        
        const resCompost = document.getElementById('res-compost');
        const resSeed = document.getElementById('res-seed');
        const resSeedType = document.getElementById('res-seed-type');
        const resCarbon = document.getElementById('res-carbon');

        // Multipliers based on soil type
        const soilData = {
            'clay': { compost: 4.0, seed: 10, carbon: 2100, seedText: 'Deep-rooting mix (Daikon Radish/Sunn Hemp) to break compaction.' },
            'sand': { compost: 6.0, seed: 15, carbon: 1800, seedText: 'High-biomass mix (Cowpea/Millet) for moisture retention.' },
            'depleted': { compost: 3.5, seed: 12, carbon: 2400, seedText: 'Nitrogen-fixing mix (Mucuna/Lablab) to restore nutrients.' }
        };

        function calculate() {
            const acres = parseFloat(landSize.value);
            const type = soilType.value;
            const data = soilData[type];

            landSizeDisplay.textContent = acres.toFixed(1);

            // Animate numbers
            animateValue(resCompost, parseFloat(resCompost.textContent), (data.compost * acres).toFixed(1), 500);
            animateValue(resSeed, parseInt(resSeed.textContent.replace(/,/g, '')), Math.round(data.seed * acres), 500);
            animateValue(resCarbon, parseInt(resCarbon.textContent.replace(/,/g, '')), Math.round(data.carbon * acres), 500, true);

            resSeedType.textContent = data.seedText;
        }

        function animateValue(obj, start, end, duration, formatString = false) {
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                
                // Ease out quad
                const easeProgress = progress * (2 - progress);
                const current = start + easeProgress * (end - start);
                
                if (formatString) {
                    obj.textContent = Math.round(current).toLocaleString();
                } else {
                    // if end has a decimal point, keep 1 decimal place, otherwise round
                    obj.textContent = end.toString().includes('.') ? current.toFixed(1) : Math.round(current);
                }

                if (progress < 1) {
                    window.requestAnimationFrame(step);
                } else {
                    if (formatString) obj.textContent = Number(end).toLocaleString();
                    else obj.textContent = end;
                }
            };
            window.requestAnimationFrame(step);
        }

        soilType.addEventListener('change', calculate);
        landSize.addEventListener('input', calculate);
        
        // Initial calc
        calculate();
    });
</script>
</Layout>
