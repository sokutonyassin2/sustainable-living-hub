---
// src/pages/forum/[id].astro
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase.js';

const { id } = Astro.params;

// Fetch topic
const { data: topic, error: topicError } = await supabase
  .from('forum_topics')
  .select('*')
  .eq('id', id)
  .single();

if (topicError || !topic) {
  return Astro.redirect('/forum');
}

// Fetch replies
const { data: replies } = await supabase
  .from('forum_replies')
  .select('*')
  .eq('topic_id', id)
  .order('created_at', { ascending: true });

// Fetch reactions for this topic and its replies
const { data: reactions } = await supabase
  .from('forum_reactions')
  .select('*')
  .eq('topic_id', id);

const safeReplies = replies || [];
const topicDate = new Date(topic.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });

// Categorize reactions
let topicReactions = { like: 0, helpful: 0, insightful: 0, total: 0 };
const replyReactionsMap = {};

if (reactions) {
  reactions.forEach(r => {
    if (!r.reply_id) {
      const type = r.reaction_type || 'like';
      topicReactions[type] = (topicReactions[type] || 0) + 1;
      topicReactions.total += 1;
    } else {
      if (!replyReactionsMap[r.reply_id]) {
        replyReactionsMap[r.reply_id] = { like: 0, helpful: 0, total: 0 };
      }
      const type = r.reaction_type || 'like';
      replyReactionsMap[r.reply_id][type] = (replyReactionsMap[r.reply_id][type] || 0) + 1;
      replyReactionsMap[r.reply_id].total += 1;
    }
  });
}

const isPinned = !!topic.is_pinned;
const isLocked = !!topic.is_locked;
const authorName = topic.author_name || topic.display_name || 'Community Member';
const authorRole = topic.author_role || (authorName.includes('Admin') ? 'Admin' : 'Normal User');

let catColor = 'bg-stone-100 text-stone-700';
if (topic.category === 'Agriculture & Soil') catColor = 'bg-emerald-100 text-emerald-800';
if (topic.category === 'Climate Solutions') catColor = 'bg-blue-100 text-blue-800';
if (topic.category === 'Urban Farming') catColor = 'bg-amber-100 text-amber-800';
---

<Layout title={`${topic.title} - Community Forum`}>
  <div class="bg-gray-50 min-h-screen pb-16">
    <!-- Header -->
    <header class="bg-secondary text-white pt-24 pb-10 px-6 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <img src="/hero_slide2.png" alt="" class="w-full h-full object-cover"/>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto">
        <a href="/forum" class="inline-flex items-center gap-1 text-stone-300 hover:text-white text-xs mb-4 transition-colors">
          <span class="material-symbols-outlined text-[16px]">arrow_back</span> Back to Discussions
        </a>
        
        <div class="flex flex-wrap items-center gap-2 mb-3">
          {isPinned && (
            <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-400 text-emerald-950">
              <span class="material-symbols-outlined text-[13px]">push_pin</span> Pinned Announcement
            </span>
          )}
          {isLocked && (
            <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-amber-400 text-amber-950">
              <span class="material-symbols-outlined text-[13px]">lock</span> Locked Discussion
            </span>
          )}
          <span class={`text-[11px] uppercase tracking-wider font-bold px-2.5 py-0.5 rounded-full ${catColor}`}>
            {topic.category || 'General'}
          </span>
          <span class="text-xs text-stone-400 flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">calendar_today</span> {topicDate}
          </span>
        </div>

        <h1 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold leading-tight text-white mb-2">{topic.title}</h1>
        <p class="text-xs text-stone-300">Started by <strong class="text-white">{authorName}</strong> <span class="uppercase tracking-wider text-[10px] text-emerald-300 font-semibold">({authorRole})</span></p>
      </div>
    </header>

    <!-- Moderator Controls Bar (Visible only to Admin/Moderator) -->
    <div id="threadModBar" class="hidden bg-emerald-950 text-white border-b border-emerald-800 px-6 py-2.5">
      <div class="max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-emerald-400 text-[18px]">gavel</span>
          <span class="font-semibold text-emerald-200">Moderator Controls:</span>
        </div>
        <div class="flex items-center gap-2">
          <button id="togglePinBtn" class="bg-emerald-800/80 hover:bg-emerald-700 text-emerald-100 px-3 py-1 rounded-lg transition-colors flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">push_pin</span>
            <span>{isPinned ? 'Unpin Topic' : 'Pin to Top'}</span>
          </button>
          <button id="toggleLockBtn" class="bg-amber-900/80 hover:bg-amber-800 text-amber-200 px-3 py-1 rounded-lg transition-colors flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">{isLocked ? 'lock_open' : 'lock'}</span>
            <span>{isLocked ? 'Unlock Topic' : 'Lock Topic'}</span>
          </button>
          <button id="deleteTopicBtn" class="bg-rose-950/80 hover:bg-rose-900 text-rose-200 px-3 py-1 rounded-lg transition-colors flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">delete</span>
            <span>Delete Topic</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 space-y-6">

      <!-- Original Post Card -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-xs border border-gray-200">
        <div class="flex items-start justify-between gap-4 pb-4 mb-4 border-b border-gray-100">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-full bg-emerald-800 text-white flex items-center justify-center font-bold text-base shadow-xs">
              {authorName.charAt(0).toUpperCase()}
            </div>
            <div>
              <div class="flex items-center gap-2">
                <p class="font-bold text-sm text-gray-900">{authorName}</p>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-stone-100 text-stone-700 uppercase">{authorRole}</span>
              </div>
              <p class="text-xs text-gray-400 mt-0.5">{topicDate}</p>
            </div>
          </div>
        </div>

        <div class="text-gray-800 text-sm sm:text-base leading-relaxed whitespace-pre-wrap">
          {topic.description || topic.content}
        </div>

        <!-- REACTION TOOLBAR FOR TOPIC -->
        <div class="mt-6 pt-4 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-gray-400 mr-1">Reactions:</span>
            
            <!-- Reaction: Like -->
            <button 
              type="button" 
              class="reaction-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-gray-600 bg-gray-50 hover:bg-rose-50 hover:text-rose-600 border border-gray-200/80 transition-all cursor-pointer"
              data-type="topic"
              data-topic-id={topic.id}
              data-reaction="like"
              title="React with Love (Login required)"
            >
              <span class="material-symbols-outlined text-[16px] text-rose-500">favorite</span>
              <span class="count-val">{(topic.likes_count || 0) + topicReactions.like}</span>
            </button>

            <!-- Reaction: Helpful -->
            <button 
              type="button" 
              class="reaction-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-gray-600 bg-gray-50 hover:bg-emerald-50 hover:text-emerald-700 border border-gray-200/80 transition-all cursor-pointer"
              data-type="topic"
              data-topic-id={topic.id}
              data-reaction="helpful"
              title="Mark as Helpful (Login required)"
            >
              <span class="material-symbols-outlined text-[16px] text-emerald-600">eco</span>
              <span class="count-val">{(topic.helpful_count || 0) + topicReactions.helpful}</span>
            </button>

            <!-- Reaction: Insightful -->
            <button 
              type="button" 
              class="reaction-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-gray-600 bg-gray-50 hover:bg-amber-50 hover:text-amber-700 border border-gray-200/80 transition-all cursor-pointer"
              data-type="topic"
              data-topic-id={topic.id}
              data-reaction="insightful"
              title="Insightful Discussion (Login required)"
            >
              <span class="material-symbols-outlined text-[16px] text-amber-500">lightbulb</span>
              <span class="count-val">{(topic.insightful_count || 0) + topicReactions.insightful}</span>
            </button>
          </div>

          <div class="text-xs text-gray-400 flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px]">visibility</span>
            <span>Public Discussion</span>
          </div>
        </div>
      </div>

      <!-- Replies Section -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="font-display text-lg font-bold text-secondary flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-600">chat_bubble</span>
            {safeReplies.length} {safeReplies.length === 1 ? 'Community Response' : 'Community Responses'}
          </h2>
          <span class="text-xs text-gray-400">Chronological</span>
        </div>

        {safeReplies.length === 0 ? (
          <div class="bg-white rounded-2xl p-8 text-center text-gray-400 border border-gray-200 shadow-xs">
            <span class="material-symbols-outlined text-4xl mb-2 text-gray-300">speaker_notes_off</span>
            <p class="font-medium text-gray-600">No replies yet.</p>
            <p class="text-xs text-gray-400 mt-1">Be the first community member to contribute your perspective!</p>
          </div>
        ) : (
          safeReplies.map((reply, idx) => {
            const rDate = new Date(reply.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
            const rAuthor = reply.author_name || reply.display_name || 'Community Member';
            const rRole = reply.author_role || (rAuthor.includes('Admin') ? 'Admin' : 'Normal User');
            const replyReacts = replyReactionsMap[reply.id] || { total: 0, like: 0, helpful: 0 };
            const initial = rAuthor.charAt(0).toUpperCase();

            return (
              <div class="bg-white rounded-2xl p-5 sm:p-6 border border-gray-200 shadow-xs transition-shadow" data-reply-id={reply.id}>
                <div class="flex items-start justify-between gap-3 mb-3">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-xs">
                      {initial}
                    </div>
                    <div>
                      <div class="flex items-center gap-2">
                        <p class="font-semibold text-sm text-gray-900">{rAuthor}</p>
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-gray-100 text-gray-600 uppercase">{rRole}</span>
                      </div>
                      <p class="text-[11px] text-gray-400 mt-0.5">{rDate}</p>
                    </div>
                  </div>

                  <!-- Delete Reply button (Moderator/Admin) -->
                  <button 
                    type="button" 
                    class="delete-reply-btn hidden text-gray-300 hover:text-red-600 p-1 rounded-lg transition-colors"
                    data-reply-id={reply.id}
                    title="Delete reply as Moderator"
                  >
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                  </button>
                </div>

                <div class="text-gray-700 text-sm leading-relaxed whitespace-pre-wrap pl-1 sm:pl-12">
                  {reply.message}
                </div>

                <!-- Reply Reactions -->
                <div class="mt-3 pt-3 border-t border-gray-50 flex items-center gap-2 pl-1 sm:pl-12">
                  <button 
                    type="button" 
                    class="reaction-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold text-gray-500 bg-gray-50 hover:bg-rose-50 hover:text-rose-600 border border-gray-100 transition-colors"
                    data-type="reply"
                    data-topic-id={topic.id}
                    data-reply-id={reply.id}
                    data-reaction="like"
                    title="Like this reply (Login required)"
                  >
                    <span class="material-symbols-outlined text-[14px] text-rose-500">favorite</span>
                    <span class="count-val">{(reply.likes_count || 0) + replyReacts.like}</span>
                  </button>

                  <button 
                    type="button" 
                    class="reaction-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold text-gray-500 bg-gray-50 hover:bg-emerald-50 hover:text-emerald-700 border border-gray-100 transition-colors"
                    data-type="reply"
                    data-topic-id={topic.id}
                    data-reply-id={reply.id}
                    data-reaction="helpful"
                    title="Helpful comment"
                  >
                    <span class="material-symbols-outlined text-[14px] text-emerald-600">eco</span>
                    <span class="count-val">{replyReacts.helpful}</span>
                  </button>
                </div>
              </div>
            );
          })
        )}
      </div>

      <!-- Locked Notice or Reply Form -->
      {isLocked ? (
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 text-center shadow-xs">
          <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center mx-auto mb-3">
            <span class="material-symbols-outlined text-2xl">lock</span>
          </div>
          <h3 class="font-bold text-amber-900 text-base mb-1">This Discussion is Locked</h3>
          <p class="text-xs text-amber-700/90 max-w-md mx-auto">
            A community moderator or administrator has locked this discussion. Replies are currently closed, but you may still review all existing posts and reactions.
          </p>
        </div>
      ) : (
        <div id="replySection" class="bg-white rounded-2xl p-6 sm:p-8 shadow-xs border border-gray-200">
          
          <!-- State A: Authenticated user can reply -->
          <div id="replyAuth" class="hidden">
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-display text-base sm:text-lg font-bold text-secondary">Post a Reply</h3>
              <div class="text-xs text-gray-500 flex items-center gap-1.5">
                <span>Replying as:</span>
                <strong id="currentReplyUser" class="text-emerald-700 font-semibold">User</strong>
              </div>
            </div>

            <form id="replyForm" class="space-y-4">
              <textarea 
                id="replyMessage" 
                required 
                rows="4" 
                class="w-full border border-gray-300 rounded-xl p-3.5 focus:ring-1 focus:ring-emerald-600 focus:border-emerald-600 text-sm outline-none transition-all" 
                placeholder="Share your thoughts, experiences, or constructive feedback..."
              ></textarea>
              
              <div class="flex items-center justify-between">
                <p class="text-[11px] text-gray-400">Keep contributions respectful and aligned with community guidelines.</p>
                <button 
                  type="submit" 
                  id="submitReplyBtn" 
                  class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2.5 rounded-xl text-xs font-semibold transition-colors flex items-center gap-2 shadow-xs cursor-pointer"
                >
                  <span class="material-symbols-outlined text-[16px]">send</span> Post Reply
                </button>
              </div>
            </form>
          </div>

          <!-- State B: Guest prompt -->
          <div id="replyLoginPrompt" class="text-center py-6">
            <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-3">
              <span class="material-symbols-outlined text-2xl">account_circle</span>
            </div>
            <h3 class="font-bold text-gray-900 text-base mb-1">Join the Conversation</h3>
            <p class="text-gray-500 text-xs max-w-sm mx-auto mb-4">
              You must have a registered account to reply to this discussion or react to community posts.
            </p>
            <a 
              href={`/forum/login?redirect=/forum/${topic.id}`} 
              class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2.5 rounded-xl text-xs font-semibold transition-all inline-flex items-center gap-1.5 shadow-sm"
            >
              <span class="material-symbols-outlined text-[16px]">login</span> Sign In / Register to Reply
            </a>
          </div>

        </div>
      )}
    </main>

    <!-- AUTH GATE MODAL: Shown whenever an unauthenticated visitor attempts to react -->
    <div id="authGateModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-3xl p-6 sm:p-8 w-full max-w-md shadow-2xl text-center relative animate-in fade-in zoom-in duration-200">
        <button id="closeAuthGateBtn" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 p-1">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>

        <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto mb-4 border border-rose-100">
          <span class="material-symbols-outlined text-3xl">favorite</span>
        </div>

        <h3 class="font-display text-2xl font-bold text-gray-900 mb-2">Sign In to React</h3>
        <p class="text-gray-500 text-sm mb-6 leading-relaxed">
          Reactions are exclusive to logged-in community members. Please sign in or register your account to share your reaction.
        </p>

        <div class="space-y-2.5">
          <a href={`/forum/login?redirect=/forum/${topic.id}`} class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 rounded-xl text-sm transition-all flex items-center justify-center gap-2 shadow-sm">
            <span class="material-symbols-outlined text-[18px]">login</span> Sign In / Register
          </a>
          <button id="authGateDismissBtn" class="w-full text-gray-500 hover:text-gray-700 font-medium py-2 text-xs transition-colors">
            Continue viewing as Guest
          </button>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ topicId: topic.id, isTopicPinned: isPinned, isTopicLocked: isLocked }}>
    window.__TOPIC_ID__ = topicId;
    window.__IS_PINNED__ = isTopicPinned;
    window.__IS_LOCKED__ = isTopicLocked;
  </script>

  <script>
    import { supabase } from '../../lib/supabase.js';

    document.addEventListener('DOMContentLoaded', async () => {
      let currentUser = null;
      let currentUserRole = 'Normal User';
      let isModOrAdmin = false;

      // 1. Session check
      const { data: { session } } = await supabase.auth.getSession();

      if (session && session.user) {
        currentUser = session.user;
        const rawRole = currentUser.user_metadata?.role || currentUser.role || 'Normal User';
        if (rawRole === 'admin' || rawRole === 'Admin') currentUserRole = 'Admin';
        else if (rawRole === 'moderator' || rawRole === 'Moderator') currentUserRole = 'Moderator';
        else if (rawRole.includes('Editor')) currentUserRole = 'Editor(Blogs)';
        else currentUserRole = 'Normal User';

        isModOrAdmin = currentUserRole === 'Admin' || currentUserRole === 'Moderator';

        // Unlock reply form
        document.getElementById('replyLoginPrompt')?.classList.add('hidden');
        document.getElementById('replyAuth')?.classList.remove('hidden');
        
        const replyUserEl = document.getElementById('currentReplyUser');
        if (replyUserEl) {
          replyUserEl.textContent = `${currentUser.email} (${currentUserRole})`;
        }

        // Show moderator controls
        if (isModOrAdmin) {
          document.getElementById('threadModBar')?.classList.remove('hidden');
          document.querySelectorAll('.delete-reply-btn').forEach(b => b.classList.remove('hidden'));
        }
      }

      // 2. Auth Gate Modal
      const authGateModal = document.getElementById('authGateModal');
      const showAuthGate = () => authGateModal?.classList.remove('hidden');
      const hideAuthGate = () => authGateModal?.classList.add('hidden');

      document.getElementById('closeAuthGateBtn')?.addEventListener('click', hideAuthGate);
      document.getElementById('authGateDismissBtn')?.addEventListener('click', hideAuthGate);

      // 3. Reaction Clicks (STRICTLY AUTH-GATED)
      document.querySelectorAll('.reaction-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();

          // USER REQUIREMENT: Only logged in users can react. If guest, ask to login!
          if (!currentUser) {
            showAuthGate();
            return;
          }

          const button = (e.target as HTMLElement).closest('.reaction-btn') as HTMLButtonElement;
          const rType = button.dataset.type; // 'topic' or 'reply'
          const topicId = button.dataset.topicId;
          const replyId = button.dataset.replyId || null;
          const reactionType = button.dataset.reaction || 'like';
          const countEl = button.querySelector('.count-val');

          // Record in Supabase
          const { error } = await supabase.from('forum_reactions').insert({
            topic_id: topicId,
            reply_id: replyId,
            user_id: currentUser.id,
            reaction_type: reactionType
          });

          if (!error) {
            if (countEl) {
              const cur = parseInt(countEl.textContent || '0', 10);
              countEl.textContent = String(cur + 1);
            }
            button.classList.remove('bg-gray-50', 'text-gray-600', 'text-gray-500');
            button.classList.add('bg-rose-100', 'text-rose-700', 'border-rose-300');
          }
        });
      });

      // 4. Submit Reply
      document.getElementById('replyForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('submitReplyBtn') as HTMLButtonElement;
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">progress_activity</span> Posting...';

        const message = (document.getElementById('replyMessage') as HTMLTextAreaElement).value.trim();

        const { error } = await supabase.from('forum_replies').insert([{
          topic_id: (window as any).__TOPIC_ID__,
          user_id: currentUser.id,
          author_name: currentUser?.user_metadata?.full_name || currentUser.email?.split('@')[0] || 'Community Member',
          author_role: currentUserRole,
          message: message,
          likes_count: 0
        }]);

        if (error) {
          alert('Error posting reply: ' + error.message);
          btn.disabled = false;
          btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">send</span> Post Reply';
        } else {
          window.location.reload();
        }
      });

      // 5. Moderator Actions: Pin, Lock, Delete
      document.getElementById('togglePinBtn')?.addEventListener('click', async () => {
        const topicId = (window as any).__TOPIC_ID__;
        const currentPinned = (window as any).__IS_PINNED__;
        await supabase.from('forum_topics').update({ is_pinned: !currentPinned }).eq('id', topicId);
        window.location.reload();
      });

      document.getElementById('toggleLockBtn')?.addEventListener('click', async () => {
        const topicId = (window as any).__TOPIC_ID__;
        const currentLocked = (window as any).__IS_LOCKED__;
        await supabase.from('forum_topics').update({ is_locked: !currentLocked }).eq('id', topicId);
        window.location.reload();
      });

      document.getElementById('deleteTopicBtn')?.addEventListener('click', async () => {
        const topicId = (window as any).__TOPIC_ID__;
        if (confirm('Permanently delete this topic and all replies?')) {
          await supabase.from('forum_topics').delete().eq('id', topicId);
          await supabase.from('forum_replies').delete().eq('topic_id', topicId);
          window.location.href = '/forum';
        }
      });

      // Delete individual reply
      document.querySelectorAll('.delete-reply-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = (e.target as HTMLElement).closest('.delete-reply-btn') as HTMLElement;
          const replyId = target.dataset.replyId;
          if (confirm('Delete this community reply?')) {
            await supabase.from('forum_replies').delete().eq('id', replyId);
            window.location.reload();
          }
        });
      });
    });
  </script>
</Layout>
