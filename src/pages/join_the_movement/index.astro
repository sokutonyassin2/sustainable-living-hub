---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Join the Movement">
    
    <!-- Forum Header -->
    <div class="mb-10 text-center md:text-left flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-surface-variant/40 pb-8">
        <div>
            <h1 class="font-display text-4xl md:text-5xl font-bold text-[#1B3022] mb-3">Join the Movement Forum</h1>
            <p class="text-on-surface-variant text-lg max-w-2xl font-body-lg">
                Discuss sustainability, indigenous farming practices, tree planting, and collaborate on building resilient community villages.
            </p>
        </div>
        <button onclick="openCreateModal()" class="bg-gradient-to-r from-primary to-[#0052a3] text-white px-6 py-3 rounded-full font-label-md shadow-md hover:shadow-lg hover:shadow-primary/20 transition-all flex items-center gap-2 self-center md:self-end">
            <span class="material-symbols-outlined text-[20px]">add_comment</span>
            Start a Topic
        </button>
    </div>

    <!-- Forum Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Sidebar filters -->
        <aside class="lg:col-span-3 space-y-6">
            <div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/35 shadow-sm">
                <h3 class="font-display text-xl font-bold text-[#1B3022] mb-4">Categories</h3>
                <nav class="flex flex-col gap-2" id="category-filters">
                    <button onclick="filterCategory('all')" class="category-btn text-left px-4 py-2.5 rounded-xl text-sm font-semibold text-primary bg-primary-fixed hover:bg-primary-fixed transition-colors flex justify-between items-center" data-category="all">
                        <span>All Topics</span>
                        <span class="bg-surface-container-highest px-2 py-0.5 rounded text-xs" id="count-all">0</span>
                    </button>
                    <button onclick="filterCategory('classroom')" class="category-btn text-left px-4 py-2.5 rounded-xl text-sm text-on-surface-variant hover:bg-surface-dim hover:text-primary transition-colors flex justify-between items-center" data-category="classroom">
                        <span>Practical Classroom</span>
                        <span class="bg-surface-container-highest px-2 py-0.5 rounded text-xs" id="count-classroom">0</span>
                    </button>
                    <button onclick="filterCategory('trees')" class="category-btn text-left px-4 py-2.5 rounded-xl text-sm text-on-surface-variant hover:bg-surface-dim hover:text-primary transition-colors flex justify-between items-center" data-category="trees">
                        <span>Tree Billionaires</span>
                        <span class="bg-surface-container-highest px-2 py-0.5 rounded text-xs" id="count-trees">0</span>
                    </button>
                    <button onclick="filterCategory('community')" class="category-btn text-left px-4 py-2.5 rounded-xl text-sm text-on-surface-variant hover:bg-surface-dim hover:text-primary transition-colors flex justify-between items-center" data-category="community">
                        <span>Community Villages</span>
                        <span class="bg-surface-container-highest px-2 py-0.5 rounded text-xs" id="count-community">0</span>
                    </button>
                    <button onclick="filterCategory('general')" class="category-btn text-left px-4 py-2.5 rounded-xl text-sm text-on-surface-variant hover:bg-surface-dim hover:text-primary transition-colors flex justify-between items-center" data-category="general">
                        <span>General Discussion</span>
                        <span class="bg-surface-container-highest px-2 py-0.5 rounded text-xs" id="count-general">0</span>
                    </button>
                </nav>
            </div>

            <!-- Guidelines / Stats box -->
            <div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/35 shadow-sm">
                <h3 class="font-display text-xl font-bold text-[#1B3022] mb-3">Forum Statistics</h3>
                <div class="space-y-3 text-sm text-on-surface-variant">
                    <div class="flex justify-between border-b border-surface-variant/40 pb-2">
                        <span>Total Topics</span>
                        <span class="font-bold text-[#1B3022]" id="stats-total-topics">0</span>
                    </div>
                    <div class="flex justify-between border-b border-surface-variant/40 pb-2">
                        <span>Total Reactions</span>
                        <span class="font-bold text-[#1B3022]" id="stats-total-reactions">0</span>
                    </div>
                    <div class="flex justify-between pb-1">
                        <span>Total Comments</span>
                        <span class="font-bold text-[#1B3022]" id="stats-total-comments">0</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main forum content -->
        <section class="lg:col-span-9 space-y-6">
            <!-- Search & Sort Bar -->
            <div class="flex flex-col sm:flex-row gap-4 justify-between items-center bg-surface-container-low rounded-2xl p-4 border border-outline-variant/35 shadow-sm">
                <div class="relative w-full sm:w-80">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">search</span>
                    <input type="text" id="search-input" onkeyup="handleSearch()" placeholder="Search discussions..." class="w-full pl-10 pr-4 py-2 rounded-xl border border-outline-variant bg-surface focus:outline-none focus:border-primary transition-colors text-sm"/>
                </div>
                <div class="flex items-center gap-2 self-stretch sm:self-auto justify-end">
                    <span class="text-xs text-on-surface-variant font-semibold uppercase tracking-wider">Sort:</span>
                    <select id="sort-select" onchange="handleSort()" class="py-1.5 pl-3 pr-8 rounded-xl border border-outline-variant bg-surface text-sm focus:outline-none focus:border-primary transition-colors cursor-pointer">
                        <option value="latest">Latest</option>
                        <option value="popular">Most Reacted</option>
                        <option value="comments">Most Active</option>
                    </select>
                </div>
            </div>

            <!-- Topics List Container -->
            <div id="topics-list" class="space-y-4">
                <!-- Topics will be dynamically loaded here -->
            </div>

            <!-- Empty state -->
            <div id="empty-state" class="hidden text-center py-16 bg-surface-container-low rounded-2xl border border-dashed border-outline-variant/50">
                <span class="material-symbols-outlined text-outline text-5xl mb-3">forum</span>
                <h4 class="font-display text-xl font-bold text-secondary mb-1">No topics found</h4>
                <p class="text-on-surface-variant text-sm mb-4">Be the first one to start a topic on this category!</p>
                <button onclick="openCreateModal()" class="bg-primary text-white px-5 py-2 rounded-full text-sm font-semibold hover:bg-primary-container transition-colors">
                    Start a Topic
                </button>
            </div>
        </section>
    </div>

    
<script>
    // Mock Seeding Data
    const defaultTopics = [
        {
            id: "topic_1",
            title: "Welcome to the Bill of Senga Community Forum!",
            category: "general",
            author: "Bill of Senga Team",
            content: "We are thrilled to launch this space for our community to connect. Here you can ask questions, share your successes, collaborate on projects, and discuss indigenous sustainable agriculture. Introduce yourself in the comments below!",
            date: "May 15, 2026",
            reactions: { "👍": 15, "🌱": 12, "💡": 9, "🌍": 14 },
            comments: [
                { author: "Erick S.", content: "So happy to see this forum live! Looking forward to learning from everyone here.", date: "May 15, 2026" },
                { author: "Martha M.", content: "Wonderful initiative. A great step for sharing organic practices.", date: "May 16, 2026" }
            ]
        },
        {
            id: "topic_2",
            title: "Composting tips for small kitchen gardens",
            category: "classroom",
            author: "AgriScience Pro",
            content: "For a productive organic garden, healthy soil is everything. I highly recommend using a 3-bin composting system to recycle your green kitchen scraps (nitrogen) and dry autumn leaves (carbon). Keep it moist but not soggy, turn it once a week, and in 6-8 weeks you'll have black gold for your veggies!",
            date: "May 17, 2026",
            reactions: { "👍": 8, "🌱": 19, "💡": 14, "🌍": 5 },
            comments: [
                { author: "Julius K.", content: "Tried this and it cut down my domestic food waste to almost zero! And my tomatoes are loving it.", date: "May 18, 2026" }
            ]
        },
        {
            id: "topic_3",
            title: "Join our weekend indigenous tree planting campaign",
            category: "trees",
            author: "Tree Guardian",
            content: "We are organizing a massive tree planting drive this Saturday at the Senga Community buffer zone. We aim to plant 300 native saplings including Acacia and Mahogany to restore soil hydrology. All volunteers get organic lunch and hands-on learning. Who's in?",
            date: "May 18, 2026",
            reactions: { "👍": 11, "🌱": 24, "💡": 7, "🌍": 20 },
            comments: []
        },
        {
            id: "topic_4",
            title: "Implementing greywater recycling in village households",
            category: "community",
            author: "EcoBuilder",
            content: "Water conservation is a huge priority for community village resilience. We are testing a simple gravity-fed sand and gravel filtration design to safely redirect kitchen greywater to fruit tree orchards. It's inexpensive to build and saves thousands of liters of clean water. Looking for feedback on filtering kitchen grease efficiently.",
            date: "May 19, 2026",
            reactions: { "👍": 6, "🌱": 10, "💡": 18, "🌍": 11 },
            comments: [
                { author: "Clara O.", content: "A grease trap with local pumice/charcoal layer works wonders. I can share a schematic if you'd like!", date: "May 19, 2026" }
            ]
        }
    ];

    // State Management
    let topics = [];
    let currentCategory = "all";
    let searchQuery = "";
    let sortMethod = "latest";
    let activeTopicId = null;

    // Load initial data
    function loadData() {
        const stored = localStorage.getItem("bos_forum_topics");
        if (stored) {
            topics = JSON.parse(stored);
        } else {
            topics = defaultTopics;
            saveData();
        }
        renderCounts();
        renderTopics();
    }

    function saveData() {
        localStorage.setItem("bos_forum_topics", JSON.stringify(topics));
        renderCounts();
    }

    // Category mapping labels and styling classes
    const categoriesMap = {
        classroom: { label: "Practical Classroom", class: "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300" },
        trees: { label: "Tree Billionaires", class: "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300" },
        community: { label: "Community Villages", class: "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300" },
        general: { label: "General Discussion", class: "bg-stone-100 text-stone-800 dark:bg-stone-900/30 dark:text-stone-300" }
    };

    // Render category list counts and overall stats
    function renderCounts() {
        const counts = { all: topics.length, classroom: 0, trees: 0, community: 0, general: 0 };
        let totalReactions = 0;
        let totalComments = 0;

        topics.forEach(t => {
            if (counts[t.category] !== undefined) {
                counts[t.category]++;
            }
            // Count reactions
            if (t.reactions) {
                Object.values(t.reactions).forEach(val => totalReactions += val);
            }
            // Count comments
            if (t.comments) {
                totalComments += t.comments.length;
            }
        });

        document.getElementById("count-all").innerText = counts.all;
        document.getElementById("count-classroom").innerText = counts.classroom;
        document.getElementById("count-trees").innerText = counts.trees;
        document.getElementById("count-community").innerText = counts.community;
        document.getElementById("count-general").innerText = counts.general;

        document.getElementById("stats-total-topics").innerText = topics.length;
        document.getElementById("stats-total-reactions").innerText = totalReactions;
        document.getElementById("stats-total-comments").innerText = totalComments;
    }

    // Filter by Category
    function filterCategory(cat) {
        currentCategory = cat;
        // Update active class on side filters
        document.querySelectorAll(".category-btn").forEach(btn => {
            const attr = btn.getAttribute("data-category");
            if (attr === cat) {
                btn.className = "category-btn text-left px-4 py-2.5 rounded-xl text-sm font-semibold text-primary bg-primary-fixed hover:bg-primary-fixed transition-colors flex justify-between items-center w-full";
            } else {
                btn.className = "category-btn text-left px-4 py-2.5 rounded-xl text-sm text-on-surface-variant hover:bg-surface-dim hover:text-primary transition-colors flex justify-between items-center w-full";
            }
        });
        renderTopics();
    }

    // Handle Search input
    function handleSearch() {
        searchQuery = document.getElementById("search-input").value.toLowerCase();
        renderTopics();
    }

    // Handle Sort dropdown change
    function handleSort() {
        sortMethod = document.getElementById("sort-select").value;
        renderTopics();
    }

    // Render topics list to the UI
    function renderTopics() {
        const listContainer = document.getElementById("topics-list");
        const emptyState = document.getElementById("empty-state");
        listContainer.innerHTML = "";

        // Filter
        let filtered = topics.filter(t => {
            const matchesCat = currentCategory === "all" || t.category === currentCategory;
            const matchesSearch = t.title.toLowerCase().includes(searchQuery) || t.content.toLowerCase().includes(searchQuery);
            return matchesCat && matchesSearch;
        });

        // Sort
        filtered.sort((a, b) => {
            if (sortMethod === "latest") {
                return new Date(b.date) - new Date(a.date);
            } else if (sortMethod === "popular") {
                const reactionsA = Object.values(a.reactions || {}).reduce((sum, val) => sum + val, 0);
                const reactionsB = Object.values(b.reactions || {}).reduce((sum, val) => sum + val, 0);
                return reactionsB - reactionsA;
            } else if (sortMethod === "comments") {
                return (b.comments || []).length - (a.comments || []).length;
            }
            return 0;
        });

        if (filtered.length === 0) {
            listContainer.classList.add("hidden");
            emptyState.classList.remove("hidden");
            return;
        }

        listContainer.classList.remove("hidden");
        emptyState.classList.add("hidden");

        filtered.forEach(topic => {
            const catInfo = categoriesMap[topic.category] || { label: "General", class: "bg-stone-100 text-stone-800" };
            const commentsCount = (topic.comments || []).length;
            
            // Total reactions
            const totalReactions = Object.values(topic.reactions || {}).reduce((sum, v) => sum + v, 0);

            const card = document.createElement("div");
            card.className = "bg-surface-container-low rounded-2xl p-6 border border-outline-variant/35 shadow-xs hover:shadow-md hover:border-outline transition-all duration-300 cursor-pointer flex flex-col justify-between";
            card.setAttribute("onclick", `openDetailsModal('${topic.id}', event)`);

            card.innerHTML = `
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="${catInfo.class} px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider">${catInfo.label}</span>
                        <span class="text-xs text-on-surface-variant">${topic.date}</span>
                    </div>
                    <h3 class="font-display text-xl font-bold text-[#1B3022] mb-2 hover:text-primary transition-colors leading-snug">${topic.title}</h3>
                    <p class="text-on-surface-variant text-sm line-clamp-3 mb-4 leading-relaxed">${topic.content}</p>
                </div>
                <div class="flex items-center justify-between pt-4 border-t border-surface-variant/20">
                    <span class="text-xs text-on-surface-variant">Started by <strong class="text-secondary">${topic.author}</strong></span>
                    
                    <!-- Reactions & comments indicators -->
                    <div class="flex items-center gap-4 text-xs font-semibold text-[#1B3022]" onclick="event.stopPropagation()">
                        <!-- Reactions summaries -->
                        <div class="flex items-center gap-1 bg-surface-container-highest px-3 py-1.5 rounded-full hover:bg-surface-dim transition-colors cursor-pointer" onclick="openDetailsModal('${topic.id}', event)">
                            <span class="material-symbols-outlined text-[16px] text-primary">eco</span>
                            <span>${totalReactions}</span>
                        </div>
                        
                        <!-- Comments indicator -->
                        <div class="flex items-center gap-1 bg-surface-container-highest px-3 py-1.5 rounded-full hover:bg-surface-dim transition-colors cursor-pointer" onclick="openDetailsModal('${topic.id}', event)">
                            <span class="material-symbols-outlined text-[16px] text-[#1B3022]">chat_bubble</span>
                            <span>${commentsCount}</span>
                        </div>
                    </div>
                </div>
            `;

            listContainer.appendChild(card);
        });
    }

    // Modal Control: Create Topic
    function openCreateModal() {
        const modal = document.getElementById("create-modal");
        modal.classList.remove("hidden");
        setTimeout(() => {
            modal.classList.remove("opacity-0");
            modal.querySelector("div").classList.remove("scale-95");
        }, 10);
    }

    function closeCreateModal() {
        const modal = document.getElementById("create-modal");
        modal.classList.add("opacity-0");
        modal.querySelector("div").classList.add("scale-95");
        setTimeout(() => {
            modal.classList.add("hidden");
            document.getElementById("create-topic-form").reset();
        }, 300);
    }

    // Submit new topic
    function submitTopic(event) {
        event.preventDefault();
        const title = document.getElementById("topic-title").value;
        const category = document.getElementById("topic-category").value;
        const author = document.getElementById("topic-author").value;
        const content = document.getElementById("topic-content").value;
        
        const now = new Date();
        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        const formattedDate = `${monthNames[now.getMonth()]} ${now.getDate()}, ${now.getFullYear()}`;

        const newTopic = {
            id: "topic_" + Date.now(),
            title: title,
            category: category,
            author: author,
            content: content,
            date: formattedDate,
            reactions: { "👍": 0, "🌱": 0, "💡": 0, "🌍": 0 },
            comments: []
        };

        topics.unshift(newTopic);
        saveData();
        renderTopics();
        closeCreateModal();
    }

    // Modal Control: Details & Comments
    function openDetailsModal(id, event) {
        if (event) {
            event.stopPropagation();
        }
        activeTopicId = id;
        const topic = topics.find(t => t.id === id);
        if (!topic) return;

        const catInfo = categoriesMap[topic.category] || { label: "General", class: "bg-stone-100 text-stone-800" };
        
        // Fill fields
        document.getElementById("detail-category").innerText = catInfo.label;
        document.getElementById("detail-category").className = `${catInfo.class} inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-2`;
        document.getElementById("detail-title").innerText = topic.title;
        document.getElementById("detail-author").innerText = topic.author;
        document.getElementById("detail-date").innerText = topic.date;
        document.getElementById("detail-content").innerText = topic.content;
        document.getElementById("detail-comments-count").innerText = (topic.comments || []).length;

        // Render comments
        renderComments(topic);
        
        // Render reactions buttons
        renderReactionsDetail(topic);

        // Open modal
        const modal = document.getElementById("details-modal");
        modal.classList.remove("hidden");
        setTimeout(() => {
            modal.classList.remove("opacity-0");
            modal.querySelector("div").classList.remove("scale-95");
        }, 10);
    }

    function closeDetailsModal() {
        const modal = document.getElementById("details-modal");
        modal.classList.add("opacity-0");
        modal.querySelector("div").classList.add("scale-95");
        setTimeout(() => {
            modal.classList.add("hidden");
            activeTopicId = null;
            document.getElementById("add-comment-form").reset();
        }, 300);
    }

    // Render reactions buttons inside detailed modal
    function renderReactionsDetail(topic) {
        const container = document.getElementById("detail-reactions-container");
        container.innerHTML = "";
        
        const emos = ["👍", "🌱", "💡", "🌍"];
        emos.forEach(emo => {
            const count = topic.reactions[emo] || 0;
            const btn = document.createElement("button");
            btn.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-outline-variant bg-surface hover:bg-primary-fixed hover:border-primary/50 text-sm font-semibold transition-all cursor-pointer transform hover:scale-105 active:scale-95";
            btn.onclick = () => addReaction(topic.id, emo);
            btn.innerHTML = `<span>${emo}</span> <span>${count}</span>`;
            container.appendChild(btn);
        });
    }

    // Add Reaction
    function addReaction(topicId, emo) {
        const topic = topics.find(t => t.id === topicId);
        if (!topic) return;
        
        if (!topic.reactions) {
            topic.reactions = { "👍": 0, "🌱": 0, "💡": 0, "🌍": 0 };
        }
        
        topic.reactions[emo] = (topic.reactions[emo] || 0) + 1;
        saveData();
        
        // Refresh modal list view if open
        if (activeTopicId === topicId) {
            renderReactionsDetail(topic);
        }
        renderTopics();
    }

    // Render comments list
    function renderComments(topic) {
        const commentsList = document.getElementById("detail-comments-list");
        commentsList.innerHTML = "";

        if (!topic.comments || topic.comments.length === 0) {
            commentsList.innerHTML = `
                <p class="text-xs text-on-surface-variant italic py-2">No replies yet. Join the conversation and reply!</p>
            `;
            return;
        }

        topic.comments.forEach(comment => {
            const card = document.createElement("div");
            card.className = "bg-surface-container-highest/40 border border-outline-variant/20 rounded-xl p-4 space-y-1.5";
            card.innerHTML = `
                <div class="flex items-center justify-between text-xs">
                    <strong class="text-secondary font-semibold">${comment.author}</strong>
                    <span class="text-on-surface-variant">${comment.date}</span>
                </div>
                <p class="text-on-surface-variant text-sm leading-relaxed">${comment.content}</p>
            `;
            commentsList.appendChild(card);
        });
    }

    // Submit a comment reply
    function submitComment(event) {
        event.preventDefault();
        if (!activeTopicId) return;

        const author = document.getElementById("comment-author").value;
        const content = document.getElementById("comment-content").value;
        const topic = topics.find(t => t.id === activeTopicId);
        if (!topic) return;

        const now = new Date();
        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        const formattedDate = `${monthNames[now.getMonth()]} ${now.getDate()}, ${now.getFullYear()}`;

        const newComment = {
            author: author,
            content: content,
            date: formattedDate
        };

        if (!topic.comments) {
            topic.comments = [];
        }

        topic.comments.push(newComment);
        saveData();

        // Refresh views
        document.getElementById("detail-comments-count").innerText = topic.comments.length;
        renderComments(topic);
        document.getElementById("comment-content").value = "";
        renderTopics();
    }

    // Initialize Page
    document.addEventListener("DOMContentLoaded", () => {
        loadData();
    });
</script>
</Layout>
