---
// src/pages/admin/login.astro
export const prerender = true;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login - Bill of Senga</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries" is:inline></script>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:wght@400;500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <script id="tailwind-config" is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: "#003B73",
            secondary: "#1B3022",
            surface: "#faf9f4",
          },
          fontFamily: {
            display: ["Newsreader"],
            body: ["Work Sans"],
          }
        }
      }
    }
  </script>
</head>
<body class="bg-secondary font-body flex items-center justify-center min-h-screen relative overflow-hidden">
  
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <img src="/hero_slide2.png" alt="Background" class="w-full h-full object-cover"/>
  </div>

  <div class="relative z-10 w-full max-w-md bg-white/5 backdrop-blur-xl border border-white/10 p-8 md:p-10 rounded-3xl shadow-2xl">
    
    <div class="text-center mb-8">
      <img src="/logo.png" alt="Bill of Senga" class="h-12 w-auto mx-auto mb-6 brightness-0 invert opacity-90">
      <h2 class="font-display text-3xl font-bold text-white mb-2">Admin Portal</h2>
      <p class="text-stone-300 text-sm">Sign in to manage the sustainable living hub</p>
    </div>
    
    <form id="loginForm" class="space-y-5">
      <div>
        <label for="email" class="block text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2">Email Address</label>
        <div class="relative">
          <input type="email" id="email" required class="block w-full bg-black/20 border border-white/10 text-white rounded-xl focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400 px-4 py-3 placeholder-stone-500 text-sm transition-all outline-none" placeholder="admin@billofsenga.com">
        </div>
      </div>
      
      <div>
        <label for="password" class="block text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2">Password</label>
        <div class="relative">
          <input type="password" id="password" required class="block w-full bg-black/20 border border-white/10 text-white rounded-xl focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400 px-4 py-3 placeholder-stone-500 text-sm transition-all outline-none" placeholder="••••••••">
        </div>
      </div>

      <div id="errorMessage" class="text-red-400 bg-red-900/30 border border-red-500/30 p-3 rounded-lg text-sm hidden"></div>

      <button type="submit" id="loginBtn" class="w-full bg-gradient-to-r from-primary to-[#0052a3] text-white py-3.5 rounded-xl font-semibold text-sm hover:shadow-lg hover:shadow-primary/30 transition-all border border-primary/50 flex justify-center items-center gap-2">
        Sign In
      </button>

      <!-- Demo Accounts Card -->
      <div class="mt-6 pt-5 border-t border-white/10">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">key</span> Demo Accounts
          </span>
          <span class="text-[11px] text-stone-400">Click to fill & sign in</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <button type="button" id="demoAdminBtn" class="bg-emerald-950/50 hover:bg-emerald-900/60 border border-emerald-500/30 p-3 rounded-xl text-left transition-all group focus:outline-none focus:ring-1 focus:ring-emerald-400">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-emerald-300">Admin Account</span>
              <span class="text-[10px] bg-emerald-500/20 text-emerald-300 font-semibold px-2 py-0.5 rounded-full">Full Access</span>
            </div>
            <p class="text-[11px] text-stone-300 mt-1 font-mono">admin@bos.org</p>
            <p class="text-[10px] text-stone-400 font-mono">admin123</p>
          </button>

          <button type="button" id="demoUserBtn" class="bg-white/5 hover:bg-white/10 border border-white/10 p-3 rounded-xl text-left transition-all group focus:outline-none focus:ring-1 focus:ring-white/30">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-stone-200">Member Account</span>
              <span class="text-[10px] bg-white/10 text-stone-300 font-semibold px-2 py-0.5 rounded-full">Standard</span>
            </div>
            <p class="text-[11px] text-stone-300 mt-1 font-mono">user@bos.org</p>
            <p class="text-[10px] text-stone-400 font-mono">user123</p>
          </button>
        </div>
      </div>
      
      <div class="text-center mt-6">
        <a href="/" class="text-stone-400 hover:text-white text-xs transition-colors flex items-center justify-center gap-1">
          &larr; Back to Website
        </a>
      </div>
    </form>
  </div>

  <script>
    import { supabase } from '../../lib/supabase.js';

    const loginForm = document.getElementById('loginForm');
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const errorMsg = document.getElementById('errorMessage');
    const loginBtn = document.getElementById('loginBtn');
    const demoAdminBtn = document.getElementById('demoAdminBtn');
    const demoUserBtn = document.getElementById('demoUserBtn');

    async function performLogin(emailVal: string, passwordVal: string) {
      if (!loginBtn || !errorMsg) return;
      loginBtn.setAttribute('disabled', 'true');
      loginBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span> Authenticating...';
      errorMsg.classList.add('hidden');

      const { data, error } = await supabase.auth.signInWithPassword({
        email: emailVal,
        password: passwordVal,
      });

      if (error) {
        errorMsg.textContent = error.message;
        errorMsg.classList.remove('hidden');
        loginBtn.removeAttribute('disabled');
        loginBtn.innerHTML = 'Sign In';
      } else {
        window.location.href = '/admin/dashboard';
      }
    }

    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value || '';
      const password = passwordInput?.value || '';
      await performLogin(email, password);
    });

    demoAdminBtn?.addEventListener('click', async () => {
      if (emailInput) emailInput.value = 'admin@bos.org';
      if (passwordInput) passwordInput.value = 'admin123';
      await performLogin('admin@bos.org', 'admin123');
    });

    demoUserBtn?.addEventListener('click', async () => {
      if (emailInput) emailInput.value = 'user@bos.org';
      if (passwordInput) passwordInput.value = 'user123';
      await performLogin('user@bos.org', 'user123');
    });

    // If already logged in, redirect
    const checkSession = async () => {
      const { data } = await supabase.auth.getSession();
      if (data?.session) {
        window.location.href = '/admin/dashboard';
      }
    };
    checkSession();
  </script>
</body>
</html>
