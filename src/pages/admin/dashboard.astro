  <script>
    import { supabase } from '../../lib/supabase.js';

    let currentUser = null;
    let isAdminUser = false;
    let allBlogsCache = [];
    let currentFilterStatus = 'all';

    let currentUserRole = 'Admin';

    // 1. Auth & Session Guard
    const checkAuth = async () => {
      const { data } = await supabase.auth.getSession();
      const session = data?.session;
      if (!session) {
        window.location.href = '/admin/login';
        return;
      }

      currentUser = session.user;
      const rawRole = currentUser?.user_metadata?.role || currentUser?.role || 'Admin';
      
      // Standardize role to one of the 4: 'Admin', 'Editor(Blogs)', 'Moderator', 'Normal User'
      if (rawRole === 'admin' || rawRole === 'Admin') currentUserRole = 'Admin';
      else if (rawRole === 'editor' || rawRole.includes('Editor')) currentUserRole = 'Editor(Blogs)';
      else if (rawRole === 'moderator' || rawRole === 'Moderator') currentUserRole = 'Moderator';
      else currentUserRole = 'Normal User';

      isAdminUser = currentUserRole === 'Admin';

      // Update UI Header
      const email = currentUser?.email || 'admin@senga.org';
      const sidebarEmail = document.getElementById('sidebarUserEmail');
      const topEmail = document.getElementById('topUserEmail');
      const sidebarRole = document.getElementById('sidebarUserRole');
      const topRoleBadge = document.getElementById('topRoleBadge');
      const avatar = document.getElementById('sidebarAvatar');
      const memberNotice = document.getElementById('memberNotice');

      if (sidebarEmail) sidebarEmail.textContent = email;
      if (topEmail) topEmail.textContent = email;
      if (avatar) avatar.textContent = email.charAt(0).toUpperCase();

      if (sidebarRole) sidebarRole.textContent = currentUserRole;
      if (topRoleBadge) {
        topRoleBadge.textContent = currentUserRole;
        if (currentUserRole === 'Admin') {
          topRoleBadge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 uppercase tracking-wider';
        } else if (currentUserRole === 'Editor(Blogs)') {
          topRoleBadge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 uppercase tracking-wider';
        } else if (currentUserRole === 'Moderator') {
          topRoleBadge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 uppercase tracking-wider';
        } else {
          topRoleBadge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-stone-100 text-stone-700 uppercase tracking-wider';
        }
      }

      if (currentUserRole === 'Normal User') {
        memberNotice?.classList.remove('hidden');
      } else {
        memberNotice?.classList.add('hidden');
      }

      document.getElementById('dashboardBody')?.classList.remove('hidden');
      loadBlogs();
      loadForumTopics();
      loadTeamMembers();
    };
    checkAuth();

    // Account Switchers for quick testing
    async function switchAccount(email, password) {
      await supabase.auth.signInWithPassword({ email, password });
      window.location.reload();
    }

    document.getElementById('switchAdminBtn')?.addEventListener('click', () => switchAccount('admin@senga.org', 'admin123'));
    document.getElementById('switchEditorBtn')?.addEventListener('click', () => switchAccount('editor@senga.org', 'editor123'));
    document.getElementById('switchModBtn')?.addEventListener('click', () => switchAccount('mod@senga.org', 'mod123'));
    document.getElementById('switchUserBtn')?.addEventListener('click', () => switchAccount('user@senga.org', 'user123'));
    document.getElementById('bannerSwitchAdminBtn')?.addEventListener('click', () => switchAccount('admin@senga.org', 'admin123'));

    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/admin/login';
    });

    // Tab Navigation
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');
    tabBtns.forEach(btn => {
