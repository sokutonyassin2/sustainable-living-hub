---
// src/pages/admin/dashboard.astro
export const prerender = true;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Publishing Suite - Bill of Senga</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries" is:inline></script>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:wght@400;500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <script id="tailwind-config" is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: { primary: "#003B73", secondary: "#1B3022", surface: "#faf9f4" },
          fontFamily: { display: ["Newsreader"], body: ["Work Sans"] }
        }
      }
    }
  </script>
</head>
<body class="bg-[#f8f9fa] min-h-screen font-body text-gray-800 hidden flex flex-col md:flex-row antialiased" id="dashboardBody">

  <!-- Sidebar Navigation -->
  <aside class="w-full md:w-64 bg-secondary text-white flex flex-col flex-shrink-0 border-r border-emerald-950">
    <div class="p-6 border-b border-white/10 flex items-center justify-between md:block">
      <div>
        <a href="/" class="inline-block">
          <img src="/logo.png" alt="BOS" class="h-8 w-auto mb-2 brightness-0 invert opacity-90">
        </a>
        <h1 class="text-lg font-bold font-display text-white tracking-wide">Publishing Suite</h1>
        <p class="text-emerald-400 text-xs font-medium">BOS Content Manager</p>
      </div>
      <a href="/" class="text-xs text-stone-400 hover:text-white flex items-center gap-1 md:hidden">
        <span class="material-symbols-outlined text-[16px]">home</span> Site
      </a>
    </div>

    <!-- User Account Summary in Sidebar -->
    <div class="px-5 py-4 bg-black/20 border-b border-white/5 flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-emerald-700/60 border border-emerald-400/30 flex items-center justify-center text-emerald-200 font-bold text-sm" id="sidebarAvatar">
        A
      </div>
      <div class="overflow-hidden">
        <p class="text-xs font-medium text-white truncate" id="sidebarUserEmail">admin@bos.org</p>
        <div class="flex items-center gap-1.5 mt-0.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span class="text-[11px] text-emerald-300 font-semibold uppercase tracking-wider" id="sidebarUserRole">Admin</span>
        </div>
      </div>
    </div>

    <nav class="flex-grow p-4 space-y-1.5 overflow-y-auto">
      <button class="tab-btn w-full flex items-center gap-3 text-left px-4 py-3 rounded-xl bg-white/10 text-emerald-400 font-medium transition-all" data-target="tab-blog">
        <span class="material-symbols-outlined text-[20px]">edit_document</span> Blog Suite
      </button>
      <button class="tab-btn w-full flex items-center gap-3 text-left px-4 py-3 rounded-xl hover:bg-white/5 text-stone-300 font-medium transition-all" data-target="tab-forum">
        <span class="material-symbols-outlined text-[20px]">forum</span> Forum Control
      </button>
      <button class="tab-btn w-full flex items-center gap-3 text-left px-4 py-3 rounded-xl hover:bg-white/5 text-stone-300 font-medium transition-all" data-target="tab-team">
        <span class="material-symbols-outlined text-[20px]">manage_accounts</span> Team & Roles
      </button>
    </nav>

    <div class="p-4 border-t border-white/10 space-y-2">
      <a href="/" target="_blank" class="w-full flex items-center justify-center gap-2 text-stone-300 hover:text-white py-2 px-3 rounded-lg text-xs bg-white/5 hover:bg-white/10 transition-colors">
        <span class="material-symbols-outlined text-[16px]">open_in_new</span> Public Website
      </a>
      <a href="/forum" target="_blank" class="w-full flex items-center justify-center gap-2 text-emerald-300 hover:text-white py-2 px-3 rounded-lg text-xs bg-emerald-950/40 hover:bg-emerald-900/50 transition-colors">
        <span class="material-symbols-outlined text-[16px]">forum</span> Community Forum
      </a>
      <button id="logoutBtn" class="w-full flex items-center justify-center gap-2 text-stone-400 hover:text-red-400 py-2 transition-colors text-xs">
        <span class="material-symbols-outlined text-[18px]">logout</span> Sign Out
      </button>
    </div>
  </aside>

  <!-- Main Content Area -->
  <main class="flex-grow h-screen overflow-y-auto flex flex-col">
    
    <!-- Top Bar with Demo Account Switcher -->
    <header class="bg-white border-b border-gray-200/80 px-6 py-3.5 flex flex-wrap items-center justify-between gap-4 sticky top-0 z-30 shadow-xs">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-emerald-600 text-2xl">verified_user</span>
        <div>
          <span class="text-xs text-gray-500 font-medium">Session & Active Role</span>
          <div class="flex items-center gap-2">
            <span class="text-sm font-bold text-gray-800" id="topUserEmail">admin@senga.org</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 uppercase tracking-wider" id="topRoleBadge">Admin</span>
          </div>
        </div>
      </div>

      <!-- Quick Demo Switcher -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="text-xs text-gray-500 mr-1 hidden sm:inline">Test Role:</span>
        <button id="switchAdminBtn" title="Switch to Full Admin" class="text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-emerald-600 text-emerald-800 bg-emerald-50 hover:bg-emerald-100 transition-colors flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">shield_person</span> Admin
        </button>
        <button id="switchEditorBtn" title="Switch to Blog Editor" class="text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-blue-400 text-blue-800 bg-blue-50 hover:bg-blue-100 transition-colors flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">edit_note</span> Editor(Blogs)
        </button>
        <button id="switchModBtn" title="Switch to Forum Moderator" class="text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-amber-500 text-amber-800 bg-amber-50 hover:bg-amber-100 transition-colors flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">gavel</span> Moderator
        </button>
        <button id="switchUserBtn" title="Switch to Normal User" class="text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-gray-300 text-gray-700 bg-gray-50 hover:bg-gray-100 transition-colors flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">person</span> Normal User
        </button>
      </div>
    </header>

    <!-- Member Notice Banner (visible only if logged in as normal user) -->
    <div id="memberNotice" class="hidden bg-amber-50 border-b border-amber-200 px-6 py-3 flex items-center justify-between text-xs text-amber-900">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-amber-600 text-[18px]">info</span>
        <span>You are currently signed in as a <strong>Community Member</strong>. Admin publish/delete capabilities are simulated with preview access. Switch to Admin for full authorization.</span>
      </div>
      <button id="bannerSwitchAdminBtn" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold px-3 py-1 rounded-md transition-colors">
        Switch to Admin
      </button>
    </div>

    <!-- Tab Container -->
    <div class="p-6 md:p-8 flex-grow">
      
      <!-- ================================================================ -->
      <!-- TAB: BLOG PUBLISHING SUITE (DEFAULT) -->
      <!-- ================================================================ -->
      <section id="tab-blog" class="tab-content block">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-display">Publishing & Editorial Suite</h2>
            <p class="text-sm text-gray-500 mt-1">Manage articles, in-post imagery, immediate deployment, and automated scheduling.</p>
          </div>
          <button id="newPostBtn" class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl text-sm font-semibold shadow-sm hover:shadow transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">add_circle</span> Create New Article
          </button>
        </div>

        <!-- Two Column Layout: Post Directory (Left) + Cockpit Editor (Right) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          
          <!-- LEFT: Posts Directory -->
          <div class="lg:col-span-4 bg-white rounded-2xl shadow-xs border border-gray-200 flex flex-col h-[740px]">
            
            <!-- Filter Pills -->
            <div class="p-4 border-b border-gray-100 space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-gray-500">Articles Directory</span>
                <span id="postsTotalCount" class="text-xs bg-gray-100 text-gray-700 px-2 py-0.5 rounded-full font-semibold">0 posts</span>
              </div>
              
              <!-- Search bar -->
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-[18px]">search</span>
                <input type="text" id="blogSearchInput" placeholder="Filter articles..." class="w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-gray-200 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none">
              </div>

              <!-- Status Filters -->
              <div class="flex items-center gap-1 text-xs">
                <button class="status-filter-btn px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-800 font-semibold border border-emerald-200" data-status="all">All</button>
                <button class="status-filter-btn px-2.5 py-1 rounded-lg text-gray-600 hover:bg-gray-100 font-medium" data-status="published">Published</button>
                <button class="status-filter-btn px-2.5 py-1 rounded-lg text-gray-600 hover:bg-gray-100 font-medium" data-status="scheduled">Scheduled</button>
                <button class="status-filter-btn px-2.5 py-1 rounded-lg text-gray-600 hover:bg-gray-100 font-medium" data-status="draft">Drafts</button>
              </div>
            </div>

            <!-- List -->
            <div id="blogList" class="flex-grow overflow-y-auto p-3 space-y-2 divide-y divide-gray-50">
              <p class="text-xs text-gray-400 italic p-4 text-center">Loading articles...</p>
            </div>
          </div>

          <!-- RIGHT: Comprehensive Editor & Publishing Cockpit -->
          <div class="lg:col-span-8 bg-white rounded-2xl shadow-xs border border-gray-200 flex flex-col overflow-hidden">
            
            <!-- Editor Top Navigation / Tabs -->
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50/70 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[20px]">edit_document</span>
                <h3 id="editorTitle" class="font-bold text-gray-800 text-base">Create New Article</h3>
              </div>

              <!-- Mode Toggles: Edit vs Live Preview -->
              <div class="flex items-center bg-gray-200/80 p-0.5 rounded-lg text-xs font-semibold">
                <button type="button" id="editModeBtn" class="px-3 py-1.5 rounded-md bg-white text-gray-800 shadow-xs">
                  Editor
                </button>
                <button type="button" id="previewModeBtn" class="px-3 py-1.5 rounded-md text-gray-600 hover:text-gray-900">
                  Live Preview
                </button>
              </div>
            </div>

            <!-- Main Form -->
            <form id="postForm" class="p-6 overflow-y-auto space-y-5 h-[680px]">
              <input type="hidden" id="postId" />

              <!-- EDIT CONTAINER -->
              <div id="editPane" class="space-y-5">
                
                <!-- Title & Slug -->
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1.5">Article Title *</label>
                  <input type="text" id="title" required class="w-full text-base font-semibold px-4 py-2.5 rounded-xl border border-gray-300 focus:border-primary focus:ring-1 focus:ring-primary outline-none" placeholder="e.g. Indigenous Agroforestry for Drought Resilience in Senga">
                  <div class="mt-1 flex items-center gap-1 text-[11px] text-gray-400">
                    <span>Slug: /blog/</span>
                    <span id="slugPreview" class="text-primary font-mono font-medium">indigenous-agroforestry...</span>
                  </div>
                </div>

                <!-- Category & Author Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <div class="flex items-center justify-between mb-1.5">
                      <label class="block text-xs font-bold uppercase tracking-wider text-gray-600">Category *</label>
                      <button type="button" id="openNewCategoryBtn" class="text-[11px] font-semibold text-emerald-700 hover:text-emerald-900 flex items-center gap-0.5 transition-colors">
                        <span class="material-symbols-outlined text-[15px]">add_circle</span> + New Category
                      </button>
                    </div>
                    <div class="space-y-2">
                      <select id="categorySelect" class="w-full text-xs font-medium px-3.5 py-2.5 rounded-xl border border-gray-300 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none bg-white">
                        <option value="The Story of Senga">The Story of Senga</option>
                        <option value="Forestry & Climate">Forestry & Climate</option>
                        <option value="Urban Farming">Urban Farming</option>
                        <option value="Soil Science">Soil Science</option>
                        <option value="Water Harvesting">Water Harvesting</option>
                        <option value="Community Post">Community Post</option>
                        <option value="Practical Guides">Practical Guides</option>
                      </select>

                      <!-- Inline Category Creator -->
                      <div id="newCategoryBox" class="hidden p-2.5 bg-emerald-50/80 border border-emerald-200 rounded-xl space-y-2">
                        <div class="flex items-center gap-2">
                          <input type="text" id="newCategoryInput" placeholder="Enter new category name..." class="flex-grow text-xs px-3 py-1.5 rounded-lg border border-gray-300 focus:border-emerald-600 outline-none bg-white">
                          <button type="button" id="saveNewCategoryBtn" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1 transition-colors">
                            <span class="material-symbols-outlined text-[14px]">check</span> Add
                          </button>
                          <button type="button" id="cancelNewCategoryBtn" class="text-xs text-gray-500 hover:text-gray-700 px-1">
                            Cancel
                          </button>
                        </div>
                        <p id="newCategoryError" class="text-[11px] text-red-500 hidden"></p>
                      </div>
                    </div>
                  </div>

                  <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1.5 flex items-center justify-between">
                      <span>Author (Admin's Team) *</span>
                      <span class="text-[10px] font-normal text-gray-400">Team staff only</span>
                    </label>
                    <select id="authorSelect" class="w-full text-xs font-medium px-3.5 py-2.5 rounded-xl border border-gray-300 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 outline-none bg-white">
                      <option value="BOS Editorial Team">BOS Editorial Team</option>
                      <option value="William Odinga Balikuddembe">William Odinga Balikuddembe (Founder/Admin)</option>
                    </select>
                    <input type="hidden" id="authorInput" value="BOS Editorial Team">
                  </div>
                </div>

                <!-- Excerpt / Short Summary -->
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1.5">Excerpt / Meta Description</label>
                  <textarea id="excerptInput" rows="2" class="w-full text-xs font-normal px-3.5 py-2 rounded-xl border border-gray-300 focus:border-primary focus:ring-1 focus:ring-primary outline-none" placeholder="Brief summary of the article for social sharing and feed cards..."></textarea>
                </div>

                <!-- Featured Cover Image Section -->
                <div class="bg-gray-50/80 p-4 rounded-2xl border border-gray-200">
                  <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2 flex items-center justify-between">
                    <span>Featured Cover Image</span>
                    <span class="text-[11px] text-gray-400 font-normal">Shown as hero image and card thumbnail</span>
                  </label>

                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-center">
                    <!-- Thumbnail Preview -->
                    <div class="sm:col-span-1">
                      <div id="coverPreviewBox" class="w-full h-28 rounded-xl border-2 border-dashed border-gray-300 bg-gray-100 flex items-center justify-center overflow-hidden relative group">
                        <img id="coverPreviewImg" src="/blog_soil.png" alt="Cover Preview" class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                          <span class="text-white text-xs font-medium">Cover Preview</span>
                        </div>
                      </div>
                    </div>

                    <!-- Upload and URL inputs -->
                    <div class="sm:col-span-2 space-y-2">
                      <input type="file" id="coverFileInput" accept="image/*" class="w-full text-xs text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-100 file:text-emerald-800 hover:file:bg-emerald-200 cursor-pointer">
                      
                      <div class="flex items-center gap-2">
                        <span class="text-[11px] text-gray-400">or URL:</span>
                        <input type="text" id="imageUrl" value="/blog_soil.png" class="flex-grow text-xs px-3 py-1.5 rounded-lg border border-gray-300 focus:border-primary outline-none" placeholder="https://... or /image.png">
                      </div>
                      <p id="coverUploadStatus" class="text-[11px] text-emerald-600 hidden"></p>
                    </div>
                  </div>
                </div>

                <!-- WordPress-Style WYSIWYG Article Editor -->
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-[18px] text-emerald-700">edit_note</span>
                      Article Content (WordPress Visual Editor) *
                    </label>

                    <!-- WordPress Visual / Text Toggle Tabs -->
                    <div class="flex items-center rounded-lg border border-gray-300 bg-gray-100 p-0.5 text-xs font-semibold">
                      <button type="button" id="wpTabVisual" class="px-3 py-1 rounded-md bg-white text-gray-800 shadow-2xs transition-all">Visual</button>
                      <button type="button" id="wpTabText" class="px-3 py-1 rounded-md text-gray-500 hover:text-gray-800 transition-all">Text (HTML)</button>
                    </div>
                  </div>

                  <!-- In-Post Image Inserter Drawer -->
                  <div id="inPostImageDrawer" class="hidden mb-3 p-4 bg-emerald-50/80 border border-emerald-200 rounded-2xl space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-bold text-emerald-900 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">add_photo_alternate</span> Add Media to Story
                      </span>
                      <button type="button" id="closeImageDrawerBtn" class="text-gray-400 hover:text-gray-700 text-xs">✕ Cancel</button>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                      <div>
                        <label class="block text-[11px] font-semibold text-gray-700 mb-1">Upload Local Image</label>
                        <input type="file" id="inPostFileInput" accept="image/*" class="w-full text-xs text-gray-500 file:mr-2 file:py-1 file:px-2.5 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-emerald-600 file:text-white hover:file:bg-emerald-700 cursor-pointer">
                      </div>
                      <div>
                        <label class="block text-[11px] font-semibold text-gray-700 mb-1">or Image Web URL</label>
                        <input type="text" id="inPostUrlInput" placeholder="https://..." class="w-full px-3 py-1.5 rounded-lg border border-gray-300 text-xs outline-none">
                      </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                      <div>
                        <label class="block text-[11px] font-semibold text-gray-700 mb-1">Caption</label>
                        <input type="text" id="inPostCaptionInput" placeholder="e.g. Raised garden beds planted with indigenous leafy greens" class="w-full px-3 py-1.5 rounded-lg border border-gray-300 text-xs outline-none">
                      </div>
                      <div>
                        <label class="block text-[11px] font-semibold text-gray-700 mb-1">Alt Text</label>
                        <input type="text" id="inPostAltInput" placeholder="e.g. Agroforestry demonstration plot" class="w-full px-3 py-1.5 rounded-lg border border-gray-300 text-xs outline-none">
                      </div>
                    </div>

                    <button type="button" id="confirmInsertImageBtn" class="bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs px-4 py-2 rounded-xl transition-colors">
                      Insert Into Article
                    </button>
                  </div>

                  <!-- WordPress Visual Toolbar -->
                  <div id="wpVisualToolbar" class="flex flex-wrap items-center gap-1 p-2 bg-gray-100 border border-gray-300 rounded-t-2xl border-b-0">
                    <!-- Media Button -->
                    <button type="button" id="insertImageBtn" class="text-xs font-semibold px-2.5 py-1.5 rounded-lg bg-white hover:bg-emerald-50 text-emerald-800 shadow-2xs border border-gray-300 flex items-center gap-1 transition-colors mr-1" title="Add Media">
                      <span class="material-symbols-outlined text-[16px]">add_photo_alternate</span> Add Media
                    </button>

                    <div class="h-5 w-px bg-gray-300 mx-1"></div>

                    <!-- Heading format dropdown -->
                    <select id="wpFormatSelect" class="text-xs py-1 px-2 rounded-lg border border-gray-300 bg-white font-medium text-gray-700 focus:outline-none focus:border-emerald-600">
                      <option value="p">Paragraph</option>
                      <option value="h2">Heading 2</option>
                      <option value="h3">Heading 3</option>
                      <option value="h4">Heading 4</option>
                      <option value="blockquote">Quote</option>
                      <option value="pre">Preformatted</option>
                    </select>

                    <div class="h-5 w-px bg-gray-300 mx-1"></div>

                    <!-- Inline formatting buttons -->
                    <button type="button" data-cmd="bold" class="wp-tool-btn p-1.5 rounded-lg hover:bg-gray-200 text-gray-700 transition-colors" title="Bold (Ctrl+B)">
                      <span class="material-symbols-outlined text-[18px]">format_bold</span>
                    </button>
                    <button type="button" data-cmd="italic" class="wp-tool-btn p-1.5 rounded-lg hover:bg-gray-200 text-gray-700 transition-colors" title="Italic (Ctrl+I)">
                      <span class="material-symbols-outlined text-[18px]">format_italic</span>
                    </button>
                    <button type="button" data-cmd="underline" class="wp-tool-btn p-1.5 rounded-lg hover:bg-gray-200 text-gray-700 transition-colors" title="Underline (Ctrl+U)">
                      <span class="material-symbols-outlined text-[18px]">format_underlined</span>
                    </button>
                    <button type="button" data-cmd="strikeThrough" class="wp-tool-btn p-1.5 rounded-lg hover:bg-gray-200 text-gray-700 transition-colors" title="Strikethrough">
                      <span class="material-symbols-outlined text-[18px]">strikethrough_s</span>
                    </button>

                    <div class="h-5 w-px bg-gray-300 mx-1"></div>

                    <!-- Lists -->
                    <button type="button" data-cmd="insertUnorderedList" class="wp-tool-btn p-1.5 rounded-lg hover:bg-gray-200 text-gray-700 transition-colors" title="Bulleted List">
                      <span class="material-symbols-outlined text-[18px]">format_list_bulleted</span>
                    </button>
                    <button type="button" data-cmd="insertOrderedList" class="wp-tool-btn p-1.5 rounded-lg hover:bg-gray-200 text-gray-700 transition-colors" title="Numbered List">
                      <span class="material-symbols-outlined text-[18px]">format_list_numbered</span>
                    </button>
                    <button type="button" data-cmd="formatBlock" data-arg="blockquote" class="wp-tool-btn p-1.5 rounded-lg hover:bg-gray-200 text-gray-700 transition-colors" title="Blockquote">
