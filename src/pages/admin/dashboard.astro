    // =========================================================================
    // DYNAMIC CATEGORY CREATION
    // =========================================================================
    function loadCustomCategories() {
      try {
        const stored = localStorage.getItem('bos_custom_categories');
        if (stored) {
          const list = JSON.parse(stored);
          if (Array.isArray(list)) {
            list.forEach((cat: string) => {
              if (cat && !Array.from(categorySelect.options).some(o => o.value === cat)) {
                const opt = document.createElement('option');
                opt.value = cat;
                opt.textContent = cat;
                categorySelect.appendChild(opt);
              }
            });
          }
        }
      } catch (e) {}
    }
    loadCustomCategories();

    openNewCategoryBtn?.addEventListener('click', () => {
      newCategoryBox?.classList.toggle('hidden');
      if (!newCategoryBox?.classList.contains('hidden')) {
        newCategoryInput?.focus();
      }
    });

    cancelNewCategoryBtn?.addEventListener('click', () => {
      newCategoryBox?.classList.add('hidden');
      if (newCategoryInput) newCategoryInput.value = '';
      if (newCategoryError) newCategoryError.classList.add('hidden');
    });

    saveNewCategoryBtn?.addEventListener('click', () => {
      const name = newCategoryInput?.value.trim();
      if (!name) {
        if (newCategoryError) {
          newCategoryError.textContent = 'Please enter a category name.';
          newCategoryError.classList.remove('hidden');
        }
        return;
      }

      // Add to select
      if (!Array.from(categorySelect.options).some(o => o.value.toLowerCase() === name.toLowerCase())) {
        const opt = document.createElement('option');
        opt.value = name;
        opt.textContent = name;
        categorySelect.appendChild(opt);
      }
      categorySelect.value = name;

      // Persist
      try {
        const stored = localStorage.getItem('bos_custom_categories');
        const list = stored ? JSON.parse(stored) : [];
        if (!list.includes(name)) {
          list.push(name);
          localStorage.setItem('bos_custom_categories', JSON.stringify(list));
        }
      } catch (e) {}

      // Reset UI
      if (newCategoryInput) newCategoryInput.value = '';
      if (newCategoryError) newCategoryError.classList.add('hidden');
      newCategoryBox?.classList.add('hidden');
    });

    // =========================================================================
    // AUTHOR DROPDOWN POPULATION (ADMIN'S TEAM ONLY)
    // =========================================================================
    function populateAuthorDropdown(teamList: any[]) {
      if (!authorSelect) return;
      const currentVal = authorInput?.value || authorSelect.value || 'BOS Editorial Team';
      
      // Clear options
      authorSelect.innerHTML = '';

      // 1. General Editorial option
      const generalOpt = document.createElement('option');
      generalOpt.value = 'BOS Editorial Team';
      generalOpt.textContent = 'BOS Editorial Team';
      authorSelect.appendChild(generalOpt);

      // 2. Filter only Admin's team (Admin, Editor(Blogs), Moderator). Exclude 'Normal User'.
      const adminTeam = (teamList || []).filter(m => m.role === 'Admin' || m.role === 'Editor(Blogs)' || m.role === 'Moderator');

      adminTeam.forEach(m => {
        const opt = document.createElement('option');
        opt.value = m.full_name;
        opt.textContent = `${m.full_name} (${m.role})`;
        authorSelect.appendChild(opt);
      });

      // Restore previously selected or custom author
      if (currentVal) {
        const exists = Array.from(authorSelect.options).some(o => o.value === currentVal);
        if (!exists) {
          const customOpt = document.createElement('option');
          customOpt.value = currentVal;
          customOpt.textContent = currentVal;
          authorSelect.appendChild(customOpt);
        }
        authorSelect.value = currentVal;
      }
    }

    authorSelect?.addEventListener('change', () => {
      if (authorInput) authorInput.value = authorSelect.value;
    });

    // =========================================================================
    // WORDPRESS-STYLE WYSIWYG EDITOR LOGIC
    // =========================================================================

    // Visual vs Text Tab Switching
    function setWpEditorMode(visual: boolean) {
      isVisualModeActive = visual;
      if (visual) {
        // Sync HTML from textarea into Visual editor
        if (visualEditor && contentTextarea) {
          visualEditor.innerHTML = contentTextarea.value || '<p><br></p>';
        }
        visualEditor?.classList.remove('hidden');
        wpVisualToolbar?.classList.remove('hidden');
        contentTextarea?.classList.add('hidden');

        wpTabVisual?.classList.add('bg-white', 'text-gray-800', 'shadow-2xs');
        wpTabVisual?.classList.remove('text-gray-500');
        wpTabText?.classList.remove('bg-white', 'text-gray-800', 'shadow-2xs');
        wpTabText?.classList.add('text-gray-500');
      } else {
        // Sync Visual editor content into Text (HTML) textarea
        if (visualEditor && contentTextarea) {
          contentTextarea.value = visualEditor.innerHTML;
        }
        visualEditor?.classList.add('hidden');
        wpVisualToolbar?.classList.add('hidden');
        contentTextarea?.classList.remove('hidden');

        wpTabText?.classList.add('bg-white', 'text-gray-800', 'shadow-2xs');
        wpTabText?.classList.remove('text-gray-500');
        wpTabVisual?.classList.remove('bg-white', 'text-gray-800', 'shadow-2xs');
        wpTabVisual?.classList.add('text-gray-500');
      }
    }

    wpTabVisual?.addEventListener('click', () => setWpEditorMode(true));
    wpTabText?.addEventListener('click', () => setWpEditorMode(false));

    // Live two-way sync
    visualEditor?.addEventListener('input', () => {
      if (contentTextarea) contentTextarea.value = visualEditor.innerHTML;
    });
    contentTextarea?.addEventListener('input', () => {
      if (visualEditor && !isVisualModeActive) visualEditor.innerHTML = contentTextarea.value;
    });

    // Format selection dropdown (Paragraph, H2, H3, H4, Quote, Pre)
    wpFormatSelect?.addEventListener('change', () => {
      const val = wpFormatSelect.value;
      document.execCommand('formatBlock', false, `<${val}>`);
      if (contentTextarea && visualEditor) contentTextarea.value = visualEditor.innerHTML;
      visualEditor?.focus();
    });

    // Formatting Toolbar Buttons
    document.querySelectorAll('.wp-tool-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = (e.currentTarget as HTMLElement);
        const cmd = target.dataset.cmd;
        const arg = target.dataset.arg || null;
        if (!cmd) return;

        document.execCommand(cmd, false, arg);
        if (contentTextarea && visualEditor) contentTextarea.value = visualEditor.innerHTML;
        visualEditor?.focus();
      });
    });

    // Insert Link Button
    wpInsertLinkBtn?.addEventListener('click', () => {
      const url = prompt('Enter the link URL (e.g. https://senga.org/community):');
      if (url) {
        document.execCommand('createLink', false, url);
        if (contentTextarea && visualEditor) contentTextarea.value = visualEditor.innerHTML;
