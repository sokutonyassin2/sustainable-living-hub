    // In-Post Image Inserter Drawer
    const insertImageBtn = document.getElementById('insertImageBtn');
    const inPostImageDrawer = document.getElementById('inPostImageDrawer');
    const closeImageDrawerBtn = document.getElementById('closeImageDrawerBtn');
    const confirmInsertImageBtn = document.getElementById('confirmInsertImageBtn');
    const inPostFileInput = document.getElementById('inPostFileInput') as HTMLInputElement;
    const inPostUrlInput = document.getElementById('inPostUrlInput') as HTMLInputElement;
    const inPostCaptionInput = document.getElementById('inPostCaptionInput') as HTMLInputElement;
    const inPostAltInput = document.getElementById('inPostAltInput') as HTMLInputElement;

    insertImageBtn?.addEventListener('click', () => {
      inPostImageDrawer?.classList.toggle('hidden');
    });
    closeImageDrawerBtn?.addEventListener('click', () => {
      inPostImageDrawer?.classList.add('hidden');
    });

    confirmInsertImageBtn?.addEventListener('click', async () => {
      let finalImgUrl = inPostUrlInput?.value.trim();
      const file = inPostFileInput?.files?.[0];

      if (file) {
        const filePath = `inpost_${Date.now()}_${file.name.replace(/[^a-zA-Z0-9.]/g, '_')}`;
        const { data } = await supabase.storage.from('site-images').upload(filePath, file);
        finalImgUrl = data?.publicUrl || supabase.storage.from('site-images').getPublicUrl(filePath).data.publicUrl;
      }

      if (!finalImgUrl) {
        alert('Please select a file or enter an image URL.');
        return;
      }

      const caption = inPostCaptionInput?.value.trim();
      const alt = inPostAltInput?.value.trim() || caption || 'Article photo';

      const htmlSnippet = `<figure class="my-6 block"><img src="${finalImgUrl}" alt="${alt}" class="w-full rounded-2xl shadow-md border border-stone-200" />${caption ? `<figcaption class="text-xs text-stone-500 text-center mt-2 italic">${caption}</figcaption>` : ''}</figure><p><br></p>`;

      if (isVisualModeActive && visualEditor) {
        visualEditor.focus();
        document.execCommand('insertHTML', false, htmlSnippet);
        if (contentTextarea) contentTextarea.value = visualEditor.innerHTML;
      } else if (contentTextarea) {
        insertAtCursor(contentTextarea, '\n' + htmlSnippet + '\n');
      }

      inPostImageDrawer?.classList.add('hidden');
      if (inPostFileInput) inPostFileInput.value = '';
      if (inPostUrlInput) inPostUrlInput.value = '';
      if (inPostCaptionInput) inPostCaptionInput.value = '';
      if (inPostAltInput) inPostAltInput.value = '';
    });

    // Formatting Cursor Helper for raw textarea
    function insertAtCursor(textarea: HTMLTextAreaElement, text: string) {
      if (!textarea) return;
      const start = textarea.selectionStart || textarea.value.length;
      const end = textarea.selectionEnd || textarea.value.length;
      const before = textarea.value.substring(0, start);
      const after = textarea.value.substring(end);
      textarea.value = before + text + after;
      textarea.selectionStart = textarea.selectionEnd = start + text.length;
      textarea.focus();
    }

    // Mode Toggle: Publish Now / Schedule / Draft
    const publishModeRadios = document.querySelectorAll('input[name="publishMode"]');
    function updatePublishModeUI() {
      const selected = (document.querySelector('input[name="publishMode"]:checked') as HTMLInputElement)?.value;
      const cards = document.querySelectorAll('.publish-mode-card');
      cards.forEach(c => {
        c.classList.remove('border-emerald-500');
        c.classList.add('border-gray-200');
      });

      const activeRadio = document.querySelector(`input[name="publishMode"][value="${selected}"]`);
      activeRadio?.closest('.publish-mode-card')?.classList.add('border-emerald-500');
      activeRadio?.closest('.publish-mode-card')?.classList.remove('border-gray-200');

      if (selected === 'schedule') {
        schedulePickerContainer?.classList.remove('hidden');
        if (saveBtn) saveBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">schedule_send</span> Schedule Article';
        // Set default future date if empty (tomorrow at 9:00 AM)
        if (scheduledAtInput && !scheduledAtInput.value) {
          const tomorrow = new Date();
          tomorrow.setDate(tomorrow.getDate() + 1);
          tomorrow.setHours(9, 0, 0, 0);
          scheduledAtInput.value = tomorrow.toISOString().slice(0, 16);
        }
      } else if (selected === 'draft') {
        schedulePickerContainer?.classList.add('hidden');
        if (saveBtn) saveBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">save</span> Save as Draft';
      } else {
        schedulePickerContainer?.classList.add('hidden');
        if (saveBtn) saveBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">rocket_launch</span> Publish Article Now';
      }
    }

    publishModeRadios.forEach(radio => {
      radio.addEventListener('change', updatePublishModeUI);
    });

    // Featured Image file upload & preview
    coverFileInput?.addEventListener('change', async (e: any) => {
      const file = e.target.files?.[0];
      if (!file) return;

      const status = document.getElementById('coverUploadStatus');
      if (status) {
        status.textContent = 'Uploading cover image...';
        status.classList.remove('hidden');
      }

      const filePath = `cover_${Date.now()}_${file.name.replace(/[^a-zA-Z0-9.]/g, '_')}`;
      const { data, error } = await supabase.storage.from('site-images').upload(filePath, file);

      if (error) {
        if (status) status.textContent = 'Upload error: ' + error.message;
      } else {
        const publicUrl = data?.publicUrl || (supabase.storage.from('site-images').getPublicUrl(filePath).data.publicUrl);
        if (imageUrlInput) imageUrlInput.value = publicUrl;
        if (coverPreviewImg) coverPreviewImg.src = publicUrl;
        if (status) {
          status.textContent = '✓ Cover uploaded successfully!';
          setTimeout(() => status?.classList.add('hidden'), 3000);
        }
      }
    });

    imageUrlInput?.addEventListener('input', () => {
      if (coverPreviewImg && imageUrlInput.value) {
        coverPreviewImg.src = imageUrlInput.value;
      }
    });

    // Live Preview Toggle
    const editModeBtn = document.getElementById('editModeBtn');
    const previewModeBtn = document.getElementById('previewModeBtn');
    const editPane = document.getElementById('editPane');
    const previewPane = document.getElementById('previewPane');

    editModeBtn?.addEventListener('click', () => {
      editModeBtn.classList.add('bg-white', 'text-gray-800', 'shadow-xs');
      editModeBtn.classList.remove('text-gray-600');
      previewModeBtn?.classList.remove('bg-white', 'text-gray-800', 'shadow-xs');
      previewModeBtn?.classList.add('text-gray-600');
      editPane?.classList.remove('hidden');
      previewPane?.classList.add('hidden');
    });

    previewModeBtn?.addEventListener('click', () => {
      previewModeBtn.classList.add('bg-white', 'text-gray-800', 'shadow-xs');
      previewModeBtn.classList.remove('text-gray-600');
      editModeBtn?.classList.remove('bg-white', 'text-gray-800', 'shadow-xs');
      editModeBtn?.classList.add('text-gray-600');
      editPane?.classList.add('hidden');
      previewPane?.classList.remove('hidden');

      // Populate preview
      const previewTitle = document.getElementById('previewTitle');
      const previewCategoryBadge = document.getElementById('previewCategoryBadge');
      const previewAuthor = document.getElementById('previewAuthor');
      const previewFeaturedImg = document.getElementById('previewFeaturedImg') as HTMLImageElement;
      const previewBody = document.getElementById('previewBody');

      if (previewTitle) previewTitle.textContent = titleInput?.value || 'Untitled Article';
      if (previewCategoryBadge) previewCategoryBadge.textContent = categorySelect?.value || 'Community Post';
      if (previewAuthor) previewAuthor.textContent = authorInput?.value || 'BOS Editorial Team';
      if (previewFeaturedImg) previewFeaturedImg.src = imageUrlInput?.value || '/blog_soil.png';
      if (previewBody) previewBody.innerHTML = contentTextarea?.value || '<p class="italic text-gray-400">Write content to see preview...</p>';
    });

    // Load and Render Articles in Directory
    const loadBlogs = async () => {
      const { data: blogs, error } = await supabase.from('blogs').select('*').order('created_at', { ascending: false });
      allBlogsCache = blogs || [];
      renderBlogList();
    };

    function renderBlogList() {
      const listEl = document.getElementById('blogList');
      const totalCountEl = document.getElementById('postsTotalCount');
      if (!listEl) return;

      const searchVal = (document.getElementById('blogSearchInput') as HTMLInputElement)?.value.toLowerCase().trim() || '';

      let filtered = allBlogsCache.filter(b => {
        // Status filter
        if (currentFilterStatus === 'published' && !b.is_published) return false;
        if (currentFilterStatus === 'scheduled' && b.status !== 'scheduled') return false;
        if (currentFilterStatus === 'draft' && b.status !== 'draft') return false;

        // Search filter
        if (searchVal) {
          const title = (b.title || '').toLowerCase();
          const category = (b.category || '').toLowerCase();
          if (!title.includes(searchVal) && !category.includes(searchVal)) return false;
        }
        return true;
      });

      if (totalCountEl) totalCountEl.textContent = `${filtered.length} articles`;

      if (filtered.length === 0) {
        listEl.innerHTML = `<div class="p-6 text-center text-xs text-gray-400 italic">No articles match the current filter.</div>`;
        return;
      }

      listEl.innerHTML = filtered.map(blog => {
        let statusBadge = '';
        if (blog.is_published) {
          statusBadge = '<span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Live</span>';
        } else if (blog.status === 'scheduled') {
          const dateStr = blog.scheduled_at ? new Date(blog.scheduled_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) : 'Future';
          statusBadge = `<span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800"><span class="material-symbols-outlined text-[11px]">schedule</span> ${dateStr}</span>`;
        } else {
          statusBadge = '<span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-stone-100 text-stone-700">Draft</span>';
        }

        const dateDisplay = new Date(blog.created_at || Date.now()).toLocaleDateString();

        return `
          <div class="p-3 rounded-xl hover:bg-gray-50/80 transition-all border border-transparent hover:border-gray-200 cursor-pointer flex gap-3 items-start group edit-blog-item" data-id="${blog.id}">
            <img src="${blog.image_url || '/blog_soil.png'}" alt="Thumb" class="w-12 h-12 rounded-lg object-cover flex-shrink-0 bg-stone-100 border border-gray-200">
            <div class="flex-grow min-w-0">
              <div class="flex items-center justify-between gap-1 mb-1">
                <span class="text-[10px] font-semibold text-gray-400 uppercase truncate">${blog.category || 'Story'}</span>
                ${statusBadge}
              </div>
              <h4 class="font-bold text-xs text-gray-800 truncate group-hover:text-primary transition-colors">${blog.title}</h4>
              <p class="text-[11px] text-gray-400 mt-0.5">${dateDisplay} &bull; ${blog.views_count || 0} views</p>
            </div>
          </div>
        `;
      }).join('');

      document.querySelectorAll('.edit-blog-item').forEach(item => {
        item.addEventListener('click', () => {
          const blog = allBlogsCache.find(b => b.id === (item as HTMLElement).dataset.id);
          if (blog) openEditor(blog);
        });
      });
    }

    // Status filter buttons
    document.querySelectorAll('.status-filter-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.status-filter-btn').forEach(b => {
          b.classList.remove('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
          b.classList.add('text-gray-600');
        });
        const target = e.currentTarget as HTMLElement;
        target.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
        target.classList.remove('text-gray-600');
        currentFilterStatus = target.dataset.status || 'all';
        renderBlogList();
      });
    });

    document.getElementById('blogSearchInput')?.addEventListener('input', () => renderBlogList());

    // Open Editor with specific blog (or reset for new)
    const openEditor = (blog: any = null) => {
      const editorTitle = document.getElementById('editorTitle');
      const form = document.getElementById('postForm') as HTMLFormElement;
      
      // Switch to Editor pane
      editModeBtn?.click();

      if (blog) {
        if (editorTitle) editorTitle.textContent = 'Edit Article: ' + blog.title;
        (document.getElementById('postId') as HTMLInputElement).value = blog.id;
        if (titleInput) titleInput.value = blog.title || '';
        if (slugPreview) slugPreview.textContent = blog.slug || '';
        
        // Category handling
        const cat = blog.category || 'The Story of Senga';
        if (categorySelect) {
          if (!Array.from(categorySelect.options).some(o => o.value === cat)) {
            const opt = document.createElement('option');
            opt.value = cat;
            opt.textContent = cat;
            categorySelect.appendChild(opt);
          }
          categorySelect.value = cat;
        }

        // Author handling
        const aut = blog.author || 'BOS Editorial Team';
        if (authorInput) authorInput.value = aut;
        if (authorSelect) {
          if (!Array.from(authorSelect.options).some(o => o.value === aut)) {
            const opt = document.createElement('option');
            opt.value = aut;
            opt.textContent = aut;
            authorSelect.appendChild(opt);
          }
          authorSelect.value = aut;
        }

        if (excerptInput) excerptInput.value = blog.excerpt || '';
        if (imageUrlInput) imageUrlInput.value = blog.image_url || '/blog_soil.png';
        if (coverPreviewImg) coverPreviewImg.src = blog.image_url || '/blog_soil.png';
        
        // Populate WYSIWYG
        const blogContent = blog.content || '<p><br></p>';
        if (contentTextarea) contentTextarea.value = blogContent;
        if (visualEditor) visualEditor.innerHTML = blogContent;
        setWpEditorMode(true);

        // Status Mode radio
        if (blog.is_published) {
          (document.querySelector('input[name="publishMode"][value="publish_now"]') as HTMLInputElement).checked = true;
        } else if (blog.status === 'scheduled') {
          (document.querySelector('input[name="publishMode"][value="schedule"]') as HTMLInputElement).checked = true;
          if (scheduledAtInput && blog.scheduled_at) {
            scheduledAtInput.value = new Date(blog.scheduled_at).toISOString().slice(0, 16);
          }
        } else {
          (document.querySelector('input[name="publishMode"][value="draft"]') as HTMLInputElement).checked = true;
        }

        deleteBtn?.classList.remove('hidden');
        if (viewLiveLink) {
          viewLiveLink.classList.remove('hidden');
          viewLiveLink.href = `/blog/${blog.slug}?preview=true`;
        }
      } else {
        if (editorTitle) editorTitle.textContent = 'Create New Article';
        form?.reset();
        (document.getElementById('postId') as HTMLInputElement).value = '';
        if (imageUrlInput) imageUrlInput.value = '/blog_soil.png';
        if (coverPreviewImg) coverPreviewImg.src = '/blog_soil.png';
        if (authorSelect) authorSelect.value = 'BOS Editorial Team';
        if (authorInput) authorInput.value = 'BOS Editorial Team';
        if (slugPreview) slugPreview.textContent = 'new-article-slug';
        if (contentTextarea) contentTextarea.value = '<p>Write your article here...</p>';
        if (visualEditor) visualEditor.innerHTML = '<p>Write your article here...</p>';
        setWpEditorMode(true);
        (document.querySelector('input[name="publishMode"][value="publish_now"]') as HTMLInputElement).checked = true;
        deleteBtn?.classList.add('hidden');
        viewLiveLink?.classList.add('hidden');
      }

      updatePublishModeUI();
    };

    document.getElementById('newPostBtn')?.addEventListener('click', () => openEditor());

    // Save Article Submit Handler
    document.getElementById('postForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const id = (document.getElementById('postId') as HTMLInputElement)?.value;
      const title = titleInput.value.trim();
      
      // Get content from Visual or Text depending on mode
      let content = isVisualModeActive ? (visualEditor?.innerHTML || '') : (contentTextarea?.value || '');
      if (!content.trim() || content === '<p><br></p>') {
        content = contentTextarea?.value || '';
      }
      if (contentTextarea) contentTextarea.value = content;
      if (visualEditor) visualEditor.innerHTML = content;

      const imageUrl = imageUrlInput.value.trim() || '/blog_soil.png';
      const category = categorySelect.value || 'The Story of Senga';
      const author = (authorSelect?.value || authorInput?.value || 'BOS Editorial Team').trim();
      const excerpt = excerptInput.value.trim() || content.replace(/<[^>]*>/g, ' ').slice(0, 140) + '...';
      const publishMode = (document.querySelector('input[name="publishMode"]:checked') as HTMLInputElement)?.value;

      let isPublished = false;
      let status = 'draft';
      let scheduledAt = null;

      if (publishMode === 'publish_now') {
        isPublished = true;
        status = 'published';
      } else if (publishMode === 'schedule') {
        status = 'scheduled';
        isPublished = false;
        scheduledAt = scheduledAtInput?.value ? new Date(scheduledAtInput.value).toISOString() : new Date(Date.now() + 86400000).toISOString();
      } else {
        status = 'draft';
        isPublished = false;
      }

      let slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
      if (!slug) slug = `post-${Date.now()}`;

      const postData: any = {
        title,
        slug,
        category,
        author,
        excerpt,
        content,
        image_url: imageUrl,
        status,
        is_published: isPublished,
        scheduled_at: scheduledAt,
        updated_at: new Date().toISOString()
      };

      if (!id) {
        postData.created_at = new Date().toISOString();
        postData.views_count = 0;
      }

      saveBtn.disabled = true;
      saveBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[16px]">progress_activity</span> Saving...';

      let result;
      if (id) {
        result = await supabase.from('blogs').update(postData).eq('id', id);
      } else {
        result = await supabase.from('blogs').insert([postData]);
      }

      saveBtn.disabled = false;
      updatePublishModeUI();

      if (result.error) {
        alert('Save Error: ' + result.error.message);
      } else {
        if (publishStatusMsg) {
          publishStatusMsg.textContent = isPublished 
            ? '✓ Article published successfully and pushed live!' 
            : (status === 'scheduled' ? `✓ Article scheduled for ${new Date(scheduledAt).toLocaleString()}!` : '✓ Draft saved successfully!');
          publishStatusMsg.className = 'text-xs font-semibold text-center mt-2 text-emerald-600';
          publishStatusMsg.classList.remove('hidden');
          setTimeout(() => publishStatusMsg?.classList.add('hidden'), 4000);
        }

        await loadBlogs();
        // If updating, refresh form with latest blog data
        if (id) {
          const updated = allBlogsCache.find(b => b.id === id);
          if (updated) openEditor(updated);
        } else {
          openEditor();
        }
      }
    });

    // Delete Article Handler
    deleteBtn?.addEventListener('click', async () => {
      const id = (document.getElementById('postId') as HTMLInputElement)?.value;
      if (!id) return;
      if (confirm('Are you sure you want to permanently delete this article? This action cannot be undone.')) {
        await supabase.from('blogs').delete().eq('id', id);
        openEditor();
        loadBlogs();
      }
    });

    // =========================================================================
    // 3. FORUM CONTROL & MODERATION LOGIC
    // =========================================================================
    let allForumTopicsCache = [];
    let currentForumFilter = 'all';

    const loadForumTopics = async () => {
      const { data: topics, error } = await supabase.from('forum_topics').select('*').order('created_at', { ascending: false });
      const tbody = document.getElementById('forumList');
      if (!tbody) return;
      
      allForumTopicsCache = topics || [];

      // Calculate and update metrics
      const totalCount = allForumTopicsCache.length;
      const pinnedCount = allForumTopicsCache.filter(t => t.is_pinned).length;
      const lockedCount = allForumTopicsCache.filter(t => t.is_locked).length;
      const totalReactions = allForumTopicsCache.reduce((acc, t) => acc + (t.likes_count || 0) + (t.helpful_count || 0) + (t.insightful_count || 0), 0);

      const metricTotal = document.getElementById('forumMetricTotal');
      const metricPinned = document.getElementById('forumMetricPinned');
      const metricLocked = document.getElementById('forumMetricLocked');
      const metricReactions = document.getElementById('forumMetricReactions');
      const badgeCount = document.getElementById('forumTopicsBadgeCount');

      if (metricTotal) metricTotal.textContent = String(totalCount);
      if (metricPinned) metricPinned.textContent = String(pinnedCount);
      if (metricLocked) metricLocked.textContent = String(lockedCount);
      if (metricReactions) metricReactions.textContent = String(totalReactions);
      if (badgeCount) badgeCount.textContent = `${totalCount} topics`;

      renderForumTable();
    };

    function renderForumTable() {
      const tbody = document.getElementById('forumList');
      if (!tbody) return;

      let filtered = [...allForumTopicsCache];
      if (currentForumFilter === 'pinned') {
        filtered = filtered.filter(t => t.is_pinned);
      } else if (currentForumFilter === 'locked') {
        filtered = filtered.filter(t => t.is_locked);
      }

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-6 text-center text-gray-500 italic">No topics found for this filter.</td></tr>`;
        return;
      }

      tbody.innerHTML = filtered.map(topic => {
        const isPinned = !!topic.is_pinned;
        const isLocked = !!topic.is_locked;
        const totalReacts = (topic.likes_count || 0) + (topic.helpful_count || 0) + (topic.insightful_count || 0);
        const authorName = topic.author_name || topic.display_name || topic.auth_users?.email || 'Community Member';
        const authorRole = topic.author_role || (authorName.includes('Admin') || authorName.includes('William') ? 'Admin' : 'Normal User');

        return `
          <tr class="hover:bg-gray-50/70 transition-colors border-b border-gray-100 ${isPinned ? 'bg-emerald-50/30' : ''}">
            <td class="px-6 py-4">
              <div class="flex items-center gap-2">
                ${isPinned ? '<span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800"><span class="material-symbols-outlined text-[12px]">push_pin</span> PINNED</span>' : ''}
                ${isLocked ? '<span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800"><span class="material-symbols-outlined text-[12px]">lock</span> LOCKED</span>' : ''}
              </div>
              <p class="font-bold text-gray-900 text-sm mt-0.5">${topic.title}</p>
              <p class="text-xs text-gray-500 line-clamp-1 mt-0.5">${topic.content || topic.description || ''}</p>
            </td>
            <td class="px-6 py-4">
              <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded-md text-[11px] font-semibold">${topic.category || 'General'}</span>
            </td>
            <td class="px-6 py-4">
              <p class="text-xs font-semibold text-gray-800">${authorName}</p>
              <span class="text-[10px] text-gray-500 uppercase">${authorRole}</span>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-3 text-xs text-gray-600">
                <span title="Total reactions" class="flex items-center gap-1 text-rose-600 font-medium">
                  <span class="material-symbols-outlined text-[14px]">favorite</span> ${totalReacts}
                </span>
                <span title="Date created" class="text-gray-400 text-[11px]">
                  ${new Date(topic.created_at).toLocaleDateString()}
                </span>
              </div>
            </td>
            <td class="px-6 py-4">
              ${isLocked 
                ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">Locked</span>'
                : '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Active</span>'
              }
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-1.5">
                <a href="/forum/${topic.id}" target="_blank" title="View discussion" class="p-1.5 text-gray-500 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition-colors">
                  <span class="material-symbols-outlined text-[18px]">open_in_new</span>
                </a>
                <button title="${isPinned ? 'Unpin topic' : 'Pin topic to top'}" class="toggle-pin-btn p-1.5 rounded-lg transition-colors ${isPinned ? 'text-emerald-700 bg-emerald-100 hover:bg-emerald-200' : 'text-gray-500 hover:text-emerald-700 hover:bg-emerald-50'}" data-id="${topic.id}" data-pinned="${isPinned}">
                  <span class="material-symbols-outlined text-[18px]">push_pin</span>
                </button>
                <button title="${isLocked ? 'Unlock discussion' : 'Lock discussion'}" class="toggle-lock-btn p-1.5 rounded-lg transition-colors ${isLocked ? 'text-amber-700 bg-amber-100 hover:bg-amber-200' : 'text-gray-500 hover:text-amber-700 hover:bg-amber-50'}" data-id="${topic.id}" data-locked="${isLocked}">
                  <span class="material-symbols-outlined text-[18px]">${isLocked ? 'lock_open' : 'lock'}</span>
                </button>
                <button title="Delete topic permanently" class="delete-topic-btn p-1.5 text-red-500 hover:text-red-700 hover:bg-red-50 rounded-lg transition-colors" data-id="${topic.id}">
                  <span class="material-symbols-outlined text-[18px]">delete</span>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      // Attach handlers
      document.querySelectorAll('.toggle-pin-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = (e.target as HTMLElement).closest('.toggle-pin-btn') as HTMLElement;
          const id = target.dataset.id;
          const currentPinned = target.dataset.pinned === 'true';
          await supabase.from('forum_topics').update({ is_pinned: !currentPinned }).eq('id', id);
          loadForumTopics();
        });
      });

      document.querySelectorAll('.toggle-lock-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = (e.target as HTMLElement).closest('.toggle-lock-btn') as HTMLElement;
          const id = target.dataset.id;
          const currentLocked = target.dataset.locked === 'true';
          await supabase.from('forum_topics').update({ is_locked: !currentLocked }).eq('id', id);
          loadForumTopics();
        });
      });

      document.querySelectorAll('.delete-topic-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = (e.target as HTMLElement).closest('.delete-topic-btn') as HTMLElement;
          const id = target.dataset.id;
          if (confirm('Permanently delete this discussion topic and all of its replies?')) {
            await supabase.from('forum_topics').delete().eq('id', id);
            await supabase.from('forum_replies').delete().eq('topic_id', id);
            loadForumTopics();
          }
        });
      });
    }

    // Filter tabs
    const forumFilterAll = document.getElementById('forumFilterAll');
    const forumFilterPinned = document.getElementById('forumFilterPinned');
    const forumFilterLocked = document.getElementById('forumFilterLocked');

    function updateForumFilterUI(activeBtn, filter) {
      currentForumFilter = filter;
      [forumFilterAll, forumFilterPinned, forumFilterLocked].forEach(b => {
        b?.classList.remove('bg-white', 'border', 'border-gray-300', 'font-semibold', 'text-gray-700', 'shadow-xs');
        b?.classList.add('bg-gray-100', 'font-medium', 'text-gray-600');
      });
      activeBtn?.classList.remove('bg-gray-100', 'font-medium', 'text-gray-600');
      activeBtn?.classList.add('bg-white', 'border', 'border-gray-300', 'font-semibold', 'text-gray-700', 'shadow-xs');
      renderForumTable();
    }

    forumFilterAll?.addEventListener('click', () => updateForumFilterUI(forumFilterAll, 'all'));
    forumFilterPinned?.addEventListener('click', () => updateForumFilterUI(forumFilterPinned, 'pinned'));
    forumFilterLocked?.addEventListener('click', () => updateForumFilterUI(forumFilterLocked, 'locked'));

    // =========================================================================
    // 4. TEAM & ROLE MANAGEMENT LOGIC
    // =========================================================================
    let allTeamMembers: any[] = [];

    const loadTeamMembers = async () => {
      const { data: members, error } = await supabase.from('team_members').select('*').order('created_at', { ascending: false });
      const tbody = document.getElementById('teamMembersList');
      const badge = document.getElementById('teamTotalBadge');
      if (!tbody) return;

      allTeamMembers = members || [];
      if (badge) badge.textContent = `${allTeamMembers.length} accounts`;

      // Update author dropdown in blog publishing suite with Admin's team
      populateAuthorDropdown(allTeamMembers);

      if (allTeamMembers.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-6 text-center text-gray-500 italic">No team accounts found. Provision one on the left.</td></tr>`;
        return;
      }

      tbody.innerHTML = allTeamMembers.map(member => {
        const role = member.role || 'Normal User';
        let roleBadge = '';
        if (role === 'Admin') {
          roleBadge = '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800"><span class="material-symbols-outlined text-[14px]">shield_person</span> Admin</span>';
        } else if (role === 'Editor(Blogs)') {
          roleBadge = '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800"><span class="material-symbols-outlined text-[14px]">edit_note</span> Editor(Blogs)</span>';
        } else if (role === 'Moderator') {
          roleBadge = '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800"><span class="material-symbols-outlined text-[14px]">gavel</span> Moderator</span>';
        } else {
          roleBadge = '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-stone-100 text-stone-700"><span class="material-symbols-outlined text-[14px]">person</span> Normal User</span>';
        }

        const isSuperAdmin = member.email === 'admin@senga.org' || member.email === 'admin@bos.org';
        const initial = (member.full_name || member.email || 'U').charAt(0).toUpperCase();

        return `
          <tr class="hover:bg-gray-50/70 transition-colors border-b border-gray-100">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-emerald-800 text-white font-bold flex items-center justify-center text-xs">
                  ${initial}
                </div>
                <div>
                  <p class="font-bold text-gray-900 text-sm">${member.full_name || 'Team Member'}</p>
                  <p class="text-xs text-gray-500">${member.email}</p>
                </div>
              </div>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-2">
                ${roleBadge}
                ${!isSuperAdmin ? `
                  <select class="change-role-select text-[11px] border border-gray-200 rounded-md py-0.5 px-1 bg-white text-gray-600 focus:outline-none focus:border-emerald-500" data-id="${member.id}">
                    <option value="Admin" ${role === 'Admin' ? 'selected' : ''}>Set Admin</option>
                    <option value="Editor(Blogs)" ${role === 'Editor(Blogs)' ? 'selected' : ''}>Set Editor</option>
                    <option value="Moderator" ${role === 'Moderator' ? 'selected' : ''}>Set Mod</option>
                    <option value="Normal User" ${role === 'Normal User' ? 'selected' : ''}>Set User</option>
                  </select>
                ` : ''}
              </div>
            </td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center gap-1 text-[11px] text-emerald-700 font-semibold bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active
              </span>
            </td>
            <td class="px-6 py-4 text-gray-400 text-xs">
              ${new Date(member.created_at).toLocaleDateString()}
            </td>
            <td class="px-6 py-4 text-right">
              ${!isSuperAdmin ? `
                <button class="delete-team-btn text-xs text-red-600 hover:text-red-800 font-semibold hover:underline" data-id="${member.id}" data-name="${member.full_name || member.email}">
                  Remove
                </button>
              ` : `
                <span class="text-[11px] text-gray-400 italic">Primary Admin</span>
              `}
            </td>
          </tr>
        `;
      }).join('');

      // Change role event
      document.querySelectorAll('.change-role-select').forEach(sel => {
        sel.addEventListener('change', async (e) => {
          const selectEl = e.target as HTMLSelectElement;
          const id = selectEl.dataset.id;
          const newRole = selectEl.value;
          await supabase.from('team_members').update({ role: newRole }).eq('id', id);
          loadTeamMembers();
        });
      });

      // Delete member event
      document.querySelectorAll('.delete-team-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.target as HTMLElement;
          const id = target.dataset.id;
          const name = target.dataset.name;
          if (confirm(`Are you sure you want to remove ${name} from team accounts?`)) {
            await supabase.from('team_members').delete().eq('id', id);
            loadTeamMembers();
          }
        });
      });
    };

    // Role hint updates
    const roleSelect = document.getElementById('newTeamRole') as HTMLSelectElement;
    const roleDescHint = document.getElementById('roleDescHint');
    roleSelect?.addEventListener('change', () => {
      const val = roleSelect.value;
      if (val === 'Admin') {
        roleDescHint.textContent = 'Full super-admin access to site content, publishing, team, and forum.';
      } else if (val === 'Editor(Blogs)') {
        roleDescHint.textContent = 'Can write, edit, schedule articles and upload media images.';
      } else if (val === 'Moderator') {
        roleDescHint.textContent = 'Can pin, lock, and moderate discussions on the community forum.';
      } else {
        roleDescHint.textContent = 'Standard community member who can read, reply, and react.';
      }
    });

    // Create Team Member Form Submit
    const createTeamForm = document.getElementById('createTeamUserForm');
    createTeamForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('newTeamName') as HTMLInputElement;
      const emailInput = document.getElementById('newTeamEmail') as HTMLInputElement;
      const roleInput = document.getElementById('newTeamRole') as HTMLSelectElement;
      const passInput = document.getElementById('newTeamPassword') as HTMLInputElement;
      const msgEl = document.getElementById('createTeamMsg');
      const submitBtn = document.getElementById('createTeamBtn') as HTMLButtonElement;

      const full_name = nameInput.value.trim();
      const email = emailInput.value.trim().toLowerCase();
      const role = roleInput.value;
      const password = passInput.value;

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span> Creating account...';

      // Insert into team_members table
      const { data, error } = await supabase.from('team_members').insert({
        email,
        full_name,
        role,
        password,
        status: 'active'
      });

      submitBtn.disabled = false;
      submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">add_moderator</span> Create Team Account';

      if (error) {
        msgEl.textContent = 'Error: ' + error.message;
        msgEl.className = 'text-xs p-3 rounded-lg bg-red-100 text-red-800 block';
      } else {
        msgEl.textContent = `Account created successfully! ${full_name} can now sign in as ${role}.`;
        msgEl.className = 'text-xs p-3 rounded-lg bg-emerald-100 text-emerald-800 block';
        createTeamForm.reset();
        loadTeamMembers();
        setTimeout(() => msgEl.classList.add('hidden'), 5000);
      }
    });

    document.getElementById('refreshTeamBtn')?.addEventListener('click', () => loadTeamMembers());
  </script>
</body>
</html>
